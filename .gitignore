# Raw data lives on cluster storage only, never in git (destined for GEO instead).
raw_data/

# Pipeline outputs are regenerable from raw data via the scripts -- not tracked.
# This repo tracks code only (scripts/, configs/, config.sh, docs), not results.
results/
logs/  # (now on scratch; kept as a safety net)

# HTML progress reports live in the local review copy only.
reports/

# pipeline/logs is a symlink to scratch logs (study_config/setup_links.sh).
/pipeline/logs
__pycache__/
*.pyc
