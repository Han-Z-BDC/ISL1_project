#!/bin/bash
#SBATCH --job-name=isl1_cnr_motif_report
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=00:30:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/motif_report.%j.out

# Step 9: HTML report of motifs (07) and annotation / target genes (08) for both final peak sets.
# Report: results/motif_annotation_report/ (picked up by fetch_reports.sh).
#   sbatch scripts/09_motif_annotation_report.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_cutNrun/study_config/config.sh

"${TOOLS}/python" -I "${STUDY_DIR}/scripts/motif_annotation_report.py" \
  "${GROUP_OUT}/final_peaks/final_peaks_summary.tsv" "${GROUP_OUT}/homer" "${GROUP_OUT}/annotation" \
  "${OUT_DIR}/motif_annotation_report/motif_annotation_report.html"
