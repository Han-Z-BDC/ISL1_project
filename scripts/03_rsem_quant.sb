#!/bin/bash
#SBATCH --job-name=isl1_rnaseq_rsem
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=24G
#SBATCH --time=03:00:00
#SBATCH --array=0-11
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_bulkRNAseq/logs/rsem.%A_%a.out
#SBATCH --error=/pl/active/ZhuLab_BDC/GitHub/ISL1_bulkRNAseq/logs/rsem.%A_%a.err

# Step 4: RSEM gene/isoform quantification from STAR's transcriptome BAM.
# --mem=24G / --cpus=8 (ceiling 8*3.75=30G) -- RSEM's EM step loads the
# transcript BAM + reference into memory; 24G is generous margin for this
# genome without breaching the ceiling.
#
# NOTE on strandedness: --strandedness none is the RSEM default (unstranded).
# If scripts/04_qc_bam.sb's rseqc infer_experiment.py shows this library is
# actually stranded (fwd/rev), rerun with --strandedness forward or reverse
# accordingly -- getting this wrong biases gene-level counts for genes with
# overlapping antisense transcripts.

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_bulkRNAseq/config.sh

s="${SAMPLES[${SLURM_ARRAY_TASK_ID}]}"
STAR_OUT="${OUT_DIR}/results/star/${s}"
RSEM_OUT="${OUT_DIR}/results/rsem"
mkdir -p "${RSEM_OUT}" "${LOGS}"

echo "[$(date)] RSEM quantify: ${s}"
"${TOOLS}/rsem-calculate-expression" \
  --bam \
  --no-bam-output \
  --strandedness none \
  -p "${SLURM_CPUS_PER_TASK}" \
  --seed 12345 \
  "${STAR_OUT}/Aligned.toTranscriptome.out.bam" \
  "${RSEM_REF}" \
  "${RSEM_OUT}/${s}"

echo "[$(date)] Done: ${s} -> ${RSEM_OUT}/${s}.genes.results"
