#!/bin/bash
#SBATCH --job-name=hist_csaw
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/hist_csaw.%j.out

# Step 20 (histone differential, csaw-style; agreed 2026-11-09), after csaw's H3K27me3 WT vs Ezh2
# KO workflow (csawBook ch. 11), with DESeq2 as the engine (scripts/histone_csaw_style.R):
#   - 2 kb and 5 kb windows tiled over the step 16 domains (pieces < 1/4 window dropped)
#   - 10 kb genome-wide bins (chr1-22/X/Y, blacklist-overlapping bins dropped) for background
#     normalization and the background level
#   - every fragment counted once (featureCounts --largestOverlap)
# Needs steps 16, 17 and 19 for the mark (annotation and the comparison with the original method).
# Output: results/diff/<mark>/csaw/
#   MARK=H3K27me3 sbatch --export=ALL scripts/20_histone_csaw_style.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_KO_histone_cutNrun/study_config/config.sh
MARK=${MARK:-H3K27me3}
D=${OUT_DIR}/diff/${MARK}
C=${D}/csaw
BT=${TOOLS}/bedtools
for f in "${D}/regions.bed" "${D}/samples.tsv" "${D}/counts.txt.summary" "${OUT_DIR}/isl1_consensus/genome.txt"; do
  [[ -s "${f}" ]] || { echo "ERROR: missing ${f}" >&2; exit 1; }
done
mkdir -p "${C}"
mapfile -t BAMS < <(tail -n +2 "${D}/samples.tsv" | cut -f6)
saf () { awk 'BEGIN{OFS="\t"; print "GeneID", "Chr", "Start", "End", "Strand"} {print $4, $1, $2 + 1, $3, "+"}' "$1"; }
fc () {
  # $1 = stem (bed + saf exist) -> $1.counts.txt
  saf "$1.bed" > "$1.saf"
  "${FEATURECOUNTS}" -T "${SLURM_CPUS_PER_TASK:-12}" -p --countReadPairs --largestOverlap -F SAF -a "$1.saf" \
    -o "$1.counts.txt" "${BAMS[@]}" 2> "$1.featureCounts.log"
}

awk -F'\t' '$1 ~ /^chr([0-9]+|X|Y)$/' "${OUT_DIR}/isl1_consensus/genome.txt" | sort -k1,1 > "${C}/genome.txt"
"${BT}" makewindows -g "${C}/genome.txt" -w 10000 | "${BT}" intersect -v -a - -b "${BLACKLIST}" \
  | awk 'BEGIN{OFS="\t"} {print $1, $2, $3, "bin_"NR}' > "${C}/bins10k.bed"
echo "10 kb bins: $(wc -l < "${C}/bins10k.bed")"
fc "${C}/bins10k"

for w in 2000 5000; do
  k=$((w / 1000))k
  cut -f1-4 "${D}/regions.bed" | "${BT}" makewindows -b - -w "${w}" -i src \
    | awk -v k="${k}" -v m=$((w / 4)) 'BEGIN{OFS="\t"} $3 - $2 >= m {n[$4]++; print $1, $2, $3, $4"_"k"_w"n[$4], $4}' > "${C}/windows_${k}.bed"
  echo "${k} windows: $(wc -l < "${C}/windows_${k}.bed")"
  fc "${C}/windows_${k}"
done

RBIN=$(dirname "${FEATURECOUNTS}")
"${RBIN}/Rscript" "${STUDY_DIR}/scripts/histone_csaw_style.R" "${D}" "${C}"
