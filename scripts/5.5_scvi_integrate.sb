#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=02:00:00
#SBATCH --partition=ah200
#SBATCH --qos=gpu-normal
#SBATCH --gres=gpu:h200_2g.35gb:1
#SBATCH --job-name=scvi_integrate_5.5
#SBATCH --output=logs/scvi_integrate_5.5.%j.out
# Not an array job -- one job trains both scVI strategies (2 runs, not
# 4 -- scVI has no log/SCT-path axis, it models raw counts directly, see
# 5.5_scvi_integrate.py's docstring). GPU required: confirmed working
# CUDA-compiled torch + scvi-tools 1.2.2.post1 in single.cell env earlier
# this session. First attempt (aa100, a100-40gb) sat PENDING on
# QOSGrpGRES -- account/QOS-level GPU allocation on aa100 was maxed out
# by other jobs. Moved to ah200 (H200s): gpu-normal QOS there DOES allow
# MIG slices (unlike aa100's gpu-normal, which only allows full GPUs) --
# using the smallest one, h200_2g.35gb (35GB), still far more than this
# model size needs.

set -euo pipefail
P="${SLURM_SUBMIT_DIR:?ERROR: SLURM_SUBMIT_DIR not set -- submit via sbatch from the repo root, not run directly}"
source "${P}/config.sh"

merged_h5ad="${OUT_DIR}/integration/merged_rna_raw.h5ad"
[[ -s "${merged_h5ad}" ]] || { echo "ERROR: ${merged_h5ad} not found -- run scripts/submit_5.2_merge_rna.sh first" >&2; exit 1; }

mkdir -p "${OUT_DIR}/integration" "${P}/logs"

"${TOOLS}/python" "${P}/scripts/5.5_scvi_integrate.py" \
  --merged-rna-h5ad "${merged_h5ad}" \
  --outdir "${OUT_DIR}/integration"
