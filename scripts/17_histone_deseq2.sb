#!/bin/bash
#SBATCH --job-name=hist_deseq2
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/hist_deseq2.%j.out

# Step 17 (histone differential, part 2): DESeq2 for one mark on the step 16 counts
# (scripts/histone_deseq2.R; model, tests and sensitivity checks described there).
#   MARK=H3K27ac DROP_SAMPLE=D18_H3CTR_rep2_H3K27ac sbatch --export=ALL scripts/17_histone_deseq2.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_KO_histone_cutNrun/study_config/config.sh
MARK=${MARK:-H3K27ac}
DROP_SAMPLE=${DROP_SAMPLE:-}
D=${OUT_DIR}/diff/${MARK}
[[ -s "${D}/counts.txt" ]] || { echo "ERROR: missing ${D}/counts.txt -- run step 16 first" >&2; exit 1; }
RBIN=$(dirname "${FEATURECOUNTS}")
"${RBIN}/Rscript" "${STUDY_DIR}/scripts/histone_deseq2.R" "${D}" ${DROP_SAMPLE:+"${DROP_SAMPLE}"}
