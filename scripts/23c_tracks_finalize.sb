#!/bin/bash
#SBATCH --job-name=tracks_fin
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=06:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/tracks_fin.%j.out

# Step 23c (browser tracks, part 3): replicate means, bed tracks, IGV sessions, copy to /pl/active.
#   groups/<kind>/<group>.mean.bw  deepTools bigwigAverage of the group's replicate bigWigs (each
#                                  replicate weighted equally; bin as the kind)
#   beds/ISL1/<day>_Ctr_ISL1.{macs3_ge2,idr_any_pair}.bed  the kept control sets (D9: macs3_2of2,
#                                  the two-replicate consensus)
#   beds/<mark>/<group>_<mark>.peaks.bed  replicated peaks (overlap Nt), chr1-22/X/Y; H3K27me3
#                                  merged with a 3 kb gap (the domains of the differential analysis)
#   beds/<mark>/diff_<test>.bed    DiffBind on our union regions, median-of-ratios (rip_native),
#                                  FDR < 0.05; BED9, red = up (KO or later day), blue = down;
#                                  name = log2FC
#   igv_session_<mark>.xml         scripts/tracks_sessions.py
# Everything is copied to the repo's results/tracks on /pl/active (untracked; not purged).
#   sbatch --dependency=afterok:<23b> scripts/23c_tracks_finalize.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_KO_histone_cutNrun/study_config/config.sh
T=${OUT_DIR}/tracks; S=${T}/sf; BT=${TOOLS}/bedtools
canon () { awk -F'\t' '$1 ~ /^chr([0-9]+|X|Y)$/' "$@"; }

# Replicate means
tail -n +2 "${S}/scale_factors.tsv" | awk -F'\t' '{gsub(/"/, "", $5); n=split($5, g, ","); for (i=1; i<=n; i++) if (g[i] != "") print g[i]"\t"$2"\t"$4"\t"$1}' \
  | sort -k1,1 > "${S}/groups.tsv"
for g in $(cut -f1 "${S}/groups.tsv" | sort -u); do
  mapfile -t R < <(awk -F'\t' -v g="${g}" '$1==g' "${S}/groups.tsv")
  kind=$(cut -f2 <<< "${R[0]}"); bin=$(cut -f3 <<< "${R[0]}")
  files=(); for r in "${R[@]}"; do files+=("${T}/replicates/${kind}/$(cut -f4 <<< "${r}").bw"); done
  for f in "${files[@]}"; do [[ -s "${f}" ]] || { echo "ERROR: missing ${f}" >&2; exit 1; }; done
  mkdir -p "${T}/groups/${kind}"
  "${TOOLS}/bigwigAverage" -b "${files[@]}" -o "${T}/groups/${kind}/${g}.mean.bw" -bs "${bin}" -p 12
  echo "mean ${g} (${kind}, ${#files[@]} replicates)"
done

# Bed tracks
mkdir -p "${T}/beds/ISL1" "${T}/beds/H3K27ac" "${T}/beds/H3K27me3"
for s in macs3_ge2 idr_any_pair; do for d in D15 D18 D22; do
  cut -f1-4,7 "${OUT_DIR}/isl1_ctr_final/${s}/${d}_Ctr_ISL1.bed" > "${T}/beds/ISL1/${d}_Ctr_ISL1.${s}.bed"
done; done
awk 'BEGIN{OFS="\t"} {print $1, $2, $3, "D9_Ctr_ISL1_2of2_"NR, $7}' "${S}/D9_H3CTR_ISL1.consensus.bed" \
  > "${T}/beds/ISL1/D9_Ctr_ISL1.macs3_2of2.bed"
for f in "${OUT_DIR}"/reproducibility/overlap/D*_{H3CTR,ISL1KO}_H3K27ac.Nt.narrowPeak; do
  g=$(basename "${f}" .Nt.narrowPeak)
  canon "${f}" | cut -f1-3 | sort -k1,1 -k2,2n | "${BT}" merge -i - | awk -v g="${g}" 'BEGIN{OFS="\t"} {print $1, $2, $3, g"_"NR}' > "${T}/beds/H3K27ac/${g}.peaks.bed"
done
for f in "${OUT_DIR}"/reproducibility/overlap/D*_{H3CTR,ISL1KO}_H3K27me3.Nt.narrowPeak; do
  g=$(basename "${f}" .Nt.narrowPeak)
  canon "${f}" | cut -f1-3 | sort -k1,1 -k2,2n | "${BT}" merge -i - -d 3000 | awk -v g="${g}" 'BEGIN{OFS="\t"} {print $1, $2, $3, g"_"NR}' > "${T}/beds/H3K27me3/${g}.peaks.bed"
done
for m in H3K27ac H3K27me3; do
  for f in "${OUT_DIR}/diff/${m}/diffbind/sites"/our_union_rip_native_*.tsv; do
    t=$(basename "${f}" .tsv); t=${t#our_union_rip_native_}
    # DiffBind report: seqnames start end width strand Conc Conc_A Conc_B Fold p.value FDR (start 1-based)
    awk -F'\t' 'BEGIN{OFS="\t"} NR==1{for(i=1;i<=NF;i++) c[$i]=i; next}
      $c["FDR"] < 0.05 && $c["seqnames"] ~ /^chr([0-9]+|X|Y)$/ {
        f=$c["Fold"]; col=(f > 0 ? "214,39,40" : "31,119,180")
        print $c["seqnames"], $c["start"] - 1, $c["end"], sprintf("%.2f", f), 0, ".", $c["start"] - 1, $c["end"], col}' "${f}" \
      | sort -k1,1 -k2,2n > "${T}/beds/${m}/diff_${t}.bed"
  done
done
for d in "${T}"/beds/*; do echo "$(basename "${d}"): $(ls "${d}" | wc -l) bed files"; done

"${TOOLS}/python3" -I "${STUDY_DIR}/scripts/tracks_sessions.py" "${T}"
du -sh "${T}/replicates" "${T}/groups" "${T}/beds"

KEEP=${STUDY_DIR}/results/tracks
mkdir -p "${KEEP}"
rsync -a --exclude 'sf/*.counts.txt' "${T}/" "${KEEP}/"
echo "copied to ${KEEP} ($(du -sh "${KEEP}" | cut -f1))"
