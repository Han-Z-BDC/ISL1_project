#!/bin/bash
#SBATCH --job-name=isl1_sc_cellranger
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=200G
#SBATCH --time=24:00:00
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/logs/cellranger_multi.%j.out
#SBATCH --error=/pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/logs/cellranger_multi.%j.err

# Step 1: cellranger multi on each OCM channel listed in RUNS (config.sh).
# OCM data must go through `multi` (not `count`) -- the [samples] section of
# configs/<run_id>.multi.csv maps OCM barcodes (OB1-OB4) to sample names, and
# Cell Ranger demultiplexes into results/cellranger/<run_id>/outs/per_sample_outs/<sample_id>/.
# amem (~16G/cpu default) per lab convention for cellranger; 200G is well above
# Cell Ranger's ~64G need, --localmem leaves headroom under the Slurm limit.
# Rerunning resumes an interrupted run in place (same --id, same cwd).

set -euo pipefail

source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/config.sh

mkdir -p "${CELLRANGER_OUT}" "${LOGS}"
cd "${CELLRANGER_OUT}"

LOCALMEM=$(( SLURM_MEM_PER_NODE / 1024 - 16 ))

for run in "${RUNS[@]}"; do
  csv="${OUT_DIR}/configs/${run}.multi.csv"
  if grep -q TODO "${csv}"; then
    echo "ERROR: ${csv} still has TODO sample names -- fill in the OCM barcode -> sample map first" >&2
    exit 1
  fi

  echo "[$(date)] cellranger multi: ${run} (${SLURM_CPUS_PER_TASK} cores, ${LOCALMEM}G)"
  "${CELLRANGER}" multi \
    --id="${run}" \
    --csv="${csv}" \
    --localcores="${SLURM_CPUS_PER_TASK}" \
    --localmem="${LOCALMEM}"
done

echo "[$(date)] Done. Per-sample outputs: ${CELLRANGER_OUT}/<run_id>/outs/per_sample_outs/"
