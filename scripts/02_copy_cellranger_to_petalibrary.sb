#!/bin/bash
#SBATCH --job-name=isl1_cr_to_pl
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=3G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/copy_cellranger_to_pl.%j.out

# Step 2: copy the Cell Ranger multi output from scratch (purged after 90 days) to
# PetaLibrary, into /pl/active/ZhuLab_BDC/Leia_rotation (requested 2026-10-16).
# Whole pipestance folder (~24G, ~12.5k files), not just outs/. rsync -a keeps
# permissions/timestamps and resumes if re-run. Verifies file count + total bytes at the end.
# Submit from the repo root: sbatch scripts/02_copy_cellranger_to_petalibrary.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh

DEST=/pl/active/ZhuLab_BDC/Leia_rotation/cellranger
mkdir -p "${DEST}"

for run in "${RUNS[@]}"; do
  src="${CELLRANGER_OUT}/${run}"
  [[ -d "${src}/outs" ]] || { echo "ERROR: ${src}/outs missing" >&2; exit 1; }
  echo "[$(date)] rsync ${src} -> ${DEST}/"
  rsync -a --stats "${src}" "${DEST}/"

  n_src=$(find "${src}" -type f | wc -l); n_dst=$(find "${DEST}/${run}" -type f | wc -l)
  b_src=$(du -sb --apparent-size "${src}" | cut -f1); b_dst=$(du -sb --apparent-size "${DEST}/${run}" | cut -f1)
  echo "[$(date)] ${run}: files ${n_src} -> ${n_dst}, bytes ${b_src} -> ${b_dst}"
  [[ "${n_src}" -eq "${n_dst}" && "${b_src}" -eq "${b_dst}" ]] || { echo "ERROR: copy mismatch for ${run}" >&2; exit 1; }
done
echo "[$(date)] Done. Copy verified."
