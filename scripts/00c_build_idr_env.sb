#!/bin/bash
#SBATCH --job-name=isl1_cnr_idr_env
#SBATCH --partition=acompile
#SBATCH --qos=compile
#SBATCH --cpus-per-task=4
#SBATCH --mem=30G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/build_idr_env.%j.out

# Separate env for IDR (= IDR_TOOLS in study_config/config.sh): idr 2.0.4.2 uses numpy aliases
# removed in numpy 1.24, so it is pinned to python 3.9 / numpy 1.23 here rather than added to
# the pipeline's cutnrun env. Resolved versions go to study_config/idr_env.export.yml.
#   sbatch scripts/00c_build_idr_env.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_cutNrun/study_config/config.sh

MM=/projects/hzhu10@xsede.org/software/micromamba_bootstrap/bin/micromamba
export MAMBA_ROOT_PREFIX=/projects/hzhu10@xsede.org/software/micromamba_bootstrap
ENVDIR=$(dirname "${IDR_TOOLS}")

"${MM}" create -y -p "${ENVDIR}" -c conda-forge -c bioconda \
  python=3.9 numpy=1.23 scipy matplotlib-base idr=2.0.4.2
"${MM}" env export -p "${ENVDIR}" --no-build > "${STUDY_DIR}/study_config/idr_env.export.yml"

"${IDR_TOOLS}/idr" --version
echo "idr env ready: ${IDR_TOOLS}"
