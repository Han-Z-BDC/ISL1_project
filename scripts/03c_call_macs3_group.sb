#!/bin/bash
#SBATCH --job-name=isl1_cnr_macs3_group
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=12G
#SBATCH --time=06:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/macs3_group.%A_%a.out

# Step 3c: each ISL1 replicate vs its group's IgG background (02c), one array task per ISL1
# row of samples.tsv. Two calls per replicate:
#   macs3/          q 0.01, the same MACS3 command and blacklist filter as
#                   pipeline/scripts/03_call_macs3.sb -- keep them in sync
#   macs3_relaxed/  p 0.01, no --call-summits (one row per peak), top 300k by p, blacklist
#                   filtered: input for IDR (04c), which needs the noise to model it
# A group with a single ISL1 replicate (D15 Ctr) also gets two pseudoreplicates (fragments
# split by read-name parity) called the same relaxed way, for a pseudoreplicate IDR.
#   sbatch --array=0-12 scripts/03c_call_macs3_group.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_cutNrun/study_config/config.sh
: "${SLURM_ARRAY_TASK_ID:?ERROR: submit as an array, --array=0-<n ISL1 rows - 1>}"

mapfile -t TF < <(awk -F'\t' 'NR>1 && $3=="TF" {print $2}' "${SAMPLE_SHEET}")
sample=${TF[${SLURM_ARRAY_TASK_ID}]:-}
[[ -n "${sample}" ]] || { echo "ERROR: no ISL1 row at index ${SLURM_ARRAY_TASK_ID} (have ${#TF[@]})" >&2; exit 1; }
group=$(awk -F'\t' -v s="${sample}" '$1==s {print $3"_"$4}' "${METADATA}")
[[ -n "${group}" ]] || { echo "ERROR: ${sample} not in ${METADATA}" >&2; exit 1; }

target=${OUT_DIR}/bam/${sample}.filtered.bam
control_bam=${GROUP_OUT}/igg_background/${group}.group_IgG.bam
OUT=${GROUP_OUT}/macs3
mkdir -p "${OUT}"
[[ -s "${target}" ]] || { echo "ERROR: missing ${target}" >&2; exit 1; }
[[ -s "${control_bam}" ]] || { echo "ERROR: missing ${control_bam} -- run 02c first" >&2; exit 1; }

echo "calling peaks: ${sample} vs $(basename "${control_bam}")"
"${TOOLS}/macs3" callpeak -t "${target}" -c "${control_bam}" -f BAMPE -g hs \
  -n "${sample}" -q "${MACS_QVALUE}" --call-summits --keep-dup all -B --outdir "${OUT}"

"${TOOLS}/bedtools" intersect -v -a "${OUT}/${sample}_peaks.narrowPeak" -b "${BLACKLIST}" \
  > "${OUT}/${sample}_peaks.filtered.narrowPeak"
"${TOOLS}/bedtools" intersect -v -a "${OUT}/${sample}_summits.bed" -b "${BLACKLIST}" \
  > "${OUT}/${sample}_summits.filtered.bed"

n_raw=$(wc -l < "${OUT}/${sample}_peaks.narrowPeak")
n_filtered=$(wc -l < "${OUT}/${sample}_peaks.filtered.narrowPeak")
echo "SUMMARY ${sample}: raw_peaks=${n_raw} blacklist_filtered_peaks=${n_filtered}"

REL=${GROUP_OUT}/macs3_relaxed
mkdir -p "${REL}"
relaxed () {
  # $1 = name, $2 = treatment BAM -> ${REL}/$1_peaks.relaxed.narrowPeak
  "${TOOLS}/macs3" callpeak -t "$2" -c "${control_bam}" -f BAMPE -g hs \
    -n "$1" -p 0.01 --keep-dup all --outdir "${REL}"
  sort -k8,8gr "${REL}/$1_peaks.narrowPeak" | awk 'NR <= 300000' \
    | "${TOOLS}/bedtools" intersect -v -a - -b "${BLACKLIST}" > "${REL}/$1_peaks.relaxed.narrowPeak"
  echo "RELAXED $1: $(wc -l < "${REL}/$1_peaks.relaxed.narrowPeak") peaks (p 0.01, top 300k, blacklist filtered)"
}
relaxed "${sample}" "${target}"

n_reps=$(awk -F'\t' -v g="${group}" 'NR>1 && $6=="ISL1" && $3"_"$4==g' "${METADATA}" | wc -l)
if (( n_reps == 1 )); then
  # Pseudoreplicates: both mates share a read name, so splitting on the parity of its last
  # field (the Illumina y coordinate) keeps pairs together and is reproducible.
  pr=${REL}/${sample}
  "${TOOLS}/samtools" view -h "${target}" | awk -v c1="${TOOLS}/samtools view -b -o ${pr}.pr1.bam -" \
    -v c2="${TOOLS}/samtools view -b -o ${pr}.pr2.bam -" '
    BEGIN { FS = OFS = "\t" }
    /^@/  { print | c1; print | c2; next }
          { n = split($1, f, ":"); if (f[n] % 2 == 0) print | c1; else print | c2 }
    END   { close(c1); close(c2) }'
  for h in pr1 pr2; do
    echo "pseudoreplicate ${h}: $("${TOOLS}/samtools" view -c -f 64 "${pr}.${h}.bam") fragments"
    relaxed "${sample}.${h}" "${pr}.${h}.bam"
  done
fi
