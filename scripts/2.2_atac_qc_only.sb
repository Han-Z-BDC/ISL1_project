#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=29G
#SBATCH --time=02:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=atac_qc_only
#SBATCH --output=logs/atac_qc_only.%A_%a.out
# acpu's MaxMemPerCPU is 3840MB (3.75GB), a hard per-partition ratio --
# --mem must stay at or under cpus-per-task x 3.75GB (here: 30G).
# --array is set at submission time by scripts/submit_2.2_atac_qc_only.sh
# -- don't hardcode a range here.
#
# --qc-only mode only (import_fragments + TSSe, no tile matrix/doublets)
# -- lighter than the full 2.2 job, but still genuinely heavy on a real
# fragment file (whole-genome parse). Started at cpus=4/mem=14G (sized
# against the single-sample D12 test, 1.7G fragment file) -- across this
# batch's real range (up to 4.24G, HZ191_MM1052_MM1059_T11_S2_rep2), that
# OOM'd at MaxRSS 14.68G. Bumped to match the full 2.2 job's cpus=8/mem=29G
# for headroom over the largest file in this batch, not just the one that
# failed -- several other samples sit in the same 3-4G range and would
# likely hit the same ceiling on a rerun.

# One array task per sample: writes {sample_id}.threshold_review.png
# (general-QC threshold diagnostic plot) and caches
# {sample_id}.import_tsse_checkpoint.h5ad, WITHOUT running the tile
# matrix, feature selection, or any doublet detector. Meant to be run for
# every sample BEFORE the full 2.2_atac_qc.sb, so each sample's cutoffs
# can be reviewed and recorded (configs/atac_qc_cutoffs_by_sample.csv --
# read by 2.2_atac_qc.sb's --sample-cutoffs-csv) before committing to the
# expensive full run.

set -euo pipefail
P="${SLURM_SUBMIT_DIR:?ERROR: SLURM_SUBMIT_DIR not set -- this script must be submitted via sbatch from the repo root (see scripts/submit_*.sh), not run directly}"
source "${P}/config.sh"

: "${SLURM_ARRAY_TASK_ID:?ERROR: this script is meant to run as an array -- submit it with scripts/submit_2.2_atac_qc_only.sh, not sbatch directly}"
: "${BLACKLIST_BED:?ERROR: BLACKLIST_BED is not set in config.sh}"

mkdir -p "${OUT_DIR}/atac_qc" "${P}/logs"

mapfile -t ROWS < <(tail -n +2 "${SAMPLE_SHEET}")
row="${ROWS[${SLURM_ARRAY_TASK_ID}]:-}"
[[ -n "${row}" ]] || { echo "ERROR: no sample at array index ${SLURM_ARRAY_TASK_ID} -- does --array's range match samples.tsv?" >&2; exit 1; }
IFS=$'\t' read -r sample_id h5_rel <<< "${row}"

outs_dir=$(dirname "${h5_rel}")
frag_path="${IN_DIR}/${outs_dir}/atac_fragments.tsv.gz"
[[ -s "${frag_path}" ]] || { echo "ERROR: ${frag_path} not found -- check samples.tsv / IN_DIR layout" >&2; exit 1; }

"${TOOLS}/python" "${P}/scripts/2.2_atac_qc.py" \
  --sample-id "${sample_id}" \
  --frag-path "${frag_path}" \
  --blacklist-bed "${BLACKLIST_BED}" \
  --config "${CONFIG_DIR}/atac_qc.yaml" \
  --outdir "${OUT_DIR}/atac_qc" \
  --qc-only
