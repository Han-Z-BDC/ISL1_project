#!/bin/bash
#SBATCH --job-name=isl1_cnr_env
#SBATCH --partition=acompile
#SBATCH --qos=compile
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/build_env.%j.out
#SBATCH --error=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/build_env.%j.err

# Build the cutnrun env from pipeline/environment.yml (= TOOLS in study_config/config.sh), then
# record the exact resolved versions in study_config/cutnrun_env.export.yml for the methods.
# envs_dirs in ~/.condarc puts it at /projects/$USER/software/anaconda/envs/cutnrun.
#   sbatch scripts/00b_build_env.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_cutNrun/study_config/config.sh

module load miniforge
conda env create -f "${PIPELINE_DIR}/environment.yml"
conda env export -n cutnrun --no-builds > "${STUDY_DIR}/study_config/cutnrun_env.export.yml"

for t in fastqc multiqc cutadapt bowtie2 samtools macs3 bamCoverage bedtools; do
  [[ -x "${TOOLS}/${t}" ]] || { echo "ERROR: ${t} missing from ${TOOLS}" >&2; exit 1; }
done
echo "cutnrun env ready: ${TOOLS}"
