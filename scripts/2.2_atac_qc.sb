#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=29G
#SBATCH --time=01:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=atac_qc
#SBATCH --output=logs/atac_qc.%A_%a.out
# --array is set at submission time by scripts/submit_2.2_atac_qc.sh -- don't
# hardcode a range here.
#
# --mem=29G: acpu's MaxMemPerCPU is 3840MB (3.75GB), a hard per-partition
# ratio -- --mem must stay at or under cpus-per-task x 3.75GB (here:
# 30G) or the scheduler needs to silently allocate more CPUs than
# requested, making the job harder to backfill. Kept cpus=8 (this is
# plausibly the heaviest step -- SnapATAC2's genome-wide tile matrix,
# scDblFinder, diagnostic clustering) rather than cutting it, since more
# CPUs also raises the memory ceiling correctly, unlike raising --mem
# alone would have.
#
# --time=01:00:00: AMULET (the slow, unpredictable part) is no longer in
# this job -- see 2.1_atac_amulet.py. Measured on this lab's real D12_rep1
# sample (6571 cells post-import): MaxRSS ~7.9G (well under the 29G
# budget -- room to cut --mem/--cpus if this holds on larger samples, not
# done yet since only one real sample has been measured), wall time
# ~3m36s. 1h budget leaves generous headroom over that; revisit the mem
# request once a few more samples confirm this isn't an outlier.

# One array task per sample: SnapATAC2 backbone (import fragments -> TSSe ->
# general QC filter -> tile matrix -> feature selection) + a 3-detector
# doublet union (SnapATAC2's own scrublet + AMULET + scDblFinder). Assumes
# CellRanger ARC output layout -- atac_fragments.tsv.gz as a sibling of the
# RNA h5 in the same outs/ directory. See scripts/2.2_atac_qc.py for the
# QC/doublet logic and configs/atac_qc.yaml for parameters + reasoning.
#
# Run BEFORE this, for every sample:
#   1. scripts/submit_2.1_atac_amulet.sh -- AMULET, separately (slow, see
#      2.1_atac_amulet.py). This job reads its cached result and fails
#      immediately if it isn't there yet.
#   2. scripts/qc_only_atac.sh <sample_id> -- fast, interactive, to tune
#      configs/atac_qc.yaml's general-QC thresholds. This job reuses its
#      cached checkpoint ({sample_id}.import_tsse_checkpoint.h5ad) rather
#      than reparsing the fragment file.

set -euo pipefail
P="${SLURM_SUBMIT_DIR:?ERROR: SLURM_SUBMIT_DIR not set -- this script must be submitted via sbatch from the repo root (see scripts/submit_*.sh), not run directly}"
source "${P}/config.sh"

: "${SLURM_ARRAY_TASK_ID:?ERROR: this script is meant to run as an array -- submit it with scripts/submit_2.2_atac_qc.sh, not sbatch directly}"
: "${BLACKLIST_BED:?ERROR: BLACKLIST_BED is not set in config.sh -- needed for SnapATAC2 feature selection}"

mkdir -p "${OUT_DIR}/atac_qc" "${P}/logs"

mapfile -t ROWS < <(tail -n +2 "${SAMPLE_SHEET}")
row="${ROWS[${SLURM_ARRAY_TASK_ID}]:-}"
[[ -n "${row}" ]] || { echo "ERROR: no sample at array index ${SLURM_ARRAY_TASK_ID} -- does --array's range match samples.tsv?" >&2; exit 1; }
IFS=$'\t' read -r sample_id h5_rel <<< "${row}"

outs_dir=$(dirname "${h5_rel}")
frag_path="${IN_DIR}/${outs_dir}/atac_fragments.tsv.gz"
[[ -s "${frag_path}" ]] || { echo "ERROR: ${frag_path} not found -- this pipeline assumes CellRanger ARC's fragment file naming; check samples.tsv / IN_DIR layout" >&2; exit 1; }

amulet_csv="${OUT_DIR}/atac_qc/amulet/${sample_id}.amulet_result.csv"
[[ -s "${amulet_csv}" ]] || { echo "ERROR: ${amulet_csv} not found -- run scripts/submit_2.1_atac_amulet.sh for this sample first" >&2; exit 1; }

"${TOOLS}/python" "${P}/scripts/2.2_atac_qc.py" \
  --sample-id "${sample_id}" \
  --frag-path "${frag_path}" \
  --blacklist-bed "${BLACKLIST_BED}" \
  --amulet-result "${amulet_csv}" \
  --config "${CONFIG_DIR}/atac_qc.yaml" \
  --sample-cutoffs-csv "${CONFIG_DIR}/atac_qc_cutoffs_by_sample.csv" \
  --outdir "${OUT_DIR}/atac_qc"
