#!/bin/bash
#SBATCH --job-name=isl1_cnr_pseudorep
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/pseudorep.%x.%A_%a.out

# Step 3d: pseudoreplicates for ENCODE's IDR QC ratios (04d), against the group IgG (02c).
#   MODE=self    one task per ISL1 row of samples.tsv: split the replicate's fragments in two
#                by read-name parity (mates share a name, so pairs stay together) and call
#                each half -> self-consistency ratio
#   MODE=pooled  one task per group with >= 2 replicates: merge the replicates' first halves
#                and their second halves (= pooling the replicates, then splitting) and call
#                each -> rescue ratio
# Relaxed calls as in 03c (p 0.01, top 300k, blacklist filtered) -- keep them in sync.
# Output: ${GROUP_OUT}/pseudorep/.
#   sbatch --array=0-12 --export=ALL,MODE=self scripts/03d_pseudoreps.sb
#   sbatch --array=0-3 --mem=32G --export=ALL,MODE=pooled scripts/03d_pseudoreps.sb   (after self)

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_cutNrun/study_config/config.sh
: "${SLURM_ARRAY_TASK_ID:?ERROR: submit as an array}"
: "${MODE:?ERROR: set MODE=self or MODE=pooled via --export}"

PR=${GROUP_OUT}/pseudorep
mkdir -p "${PR}"

relaxed () {
  # $1 = name, $2 = treatment BAM, $3 = control BAM -> ${PR}/$1_peaks.relaxed.narrowPeak
  "${TOOLS}/macs3" callpeak -t "$2" -c "$3" -f BAMPE -g hs \
    -n "$1" -p 0.01 --keep-dup all --outdir "${PR}"
  sort -k8,8gr "${PR}/$1_peaks.narrowPeak" | awk 'NR <= 300000' \
    | "${TOOLS}/bedtools" intersect -v -a - -b "${BLACKLIST}" > "${PR}/$1_peaks.relaxed.narrowPeak"
  echo "RELAXED $1: $(wc -l < "${PR}/$1_peaks.relaxed.narrowPeak") peaks"
}

case "${MODE}" in
  self)
    mapfile -t TF < <(awk -F'\t' 'NR>1 && $3=="TF" {print $2}' "${SAMPLE_SHEET}")
    sample=${TF[${SLURM_ARRAY_TASK_ID}]:-}
    [[ -n "${sample}" ]] || { echo "ERROR: no ISL1 row at index ${SLURM_ARRAY_TASK_ID}" >&2; exit 1; }
    group=$(awk -F'\t' -v s="${sample}" '$1==s {print $3"_"$4}' "${METADATA}")
    target=${OUT_DIR}/bam/${sample}.filtered.bam
    control=${GROUP_OUT}/igg_background/${group}.group_IgG.bam
    [[ -s "${target}" && -s "${control}" ]] || { echo "ERROR: missing ${target} or ${control}" >&2; exit 1; }

    "${TOOLS}/samtools" view -h "${target}" \
      | awk -v c1="${TOOLS}/samtools view -b -o ${PR}/${sample}.pr1.bam -" \
            -v c2="${TOOLS}/samtools view -b -o ${PR}/${sample}.pr2.bam -" '
        BEGIN { FS = OFS = "\t" }
        /^@/  { print | c1; print | c2; next }
              { n = split($1, f, ":"); if (f[n] % 2 == 0) print | c1; else print | c2 }
        END   { close(c1); close(c2) }'
    for h in pr1 pr2; do
      echo "${sample}.${h}: $("${TOOLS}/samtools" view -c -f 64 "${PR}/${sample}.${h}.bam") fragments"
      relaxed "${sample}.${h}" "${PR}/${sample}.${h}.bam" "${control}"
    done
    ;;

  pooled)
    mapfile -t GROUPS_MULTI < <(awk -F'\t' 'NR>1 && $6=="ISL1" {print $3"_"$4}' "${METADATA}" | sort | uniq -c | awk '$1 >= 2 {print $2}')
    group=${GROUPS_MULTI[${SLURM_ARRAY_TASK_ID}]:-}
    [[ -n "${group}" ]] || { echo "ERROR: no multi-replicate group at index ${SLURM_ARRAY_TASK_ID} (have ${#GROUPS_MULTI[@]})" >&2; exit 1; }
    control=${GROUP_OUT}/igg_background/${group}.group_IgG.bam
    mapfile -t reps < <(awk -F'\t' -v g="${group}" 'NR>1 && $6=="ISL1" && $3"_"$4==g {print $1}' "${METADATA}" | sort)
    for h in pr1 pr2; do
      halves=()
      for s in "${reps[@]}"; do
        [[ -s "${PR}/${s}.${h}.bam" ]] || { echo "ERROR: missing ${PR}/${s}.${h}.bam -- run MODE=self first" >&2; exit 1; }
        halves+=("${PR}/${s}.${h}.bam")
      done
      "${TOOLS}/samtools" merge -f -o "${PR}/${group}.pooled.${h}.bam" "${halves[@]}"
      echo "${group}.pooled.${h} (${reps[*]}): $("${TOOLS}/samtools" view -c -f 64 "${PR}/${group}.pooled.${h}.bam") fragments"
      relaxed "${group}.pooled.${h}" "${PR}/${group}.pooled.${h}.bam" "${control}"
    done
    ;;

  *) echo "ERROR: MODE must be self or pooled, got '${MODE}'" >&2; exit 1 ;;
esac
