#!/bin/bash
#SBATCH --job-name=isl1_cnr_igg_cmp
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/compare_igg.%j.out
#SBATCH --error=/scratch/alpine/hzhu10@xsede.org/ISL1_cutNrun/logs/compare_igg.%j.err

# Step 3b: per ISL1 sample, peaks vs own IgG (results/macs3) against peaks vs pooled IgG
# (results_pooled/macs3). Needs 03_call_macs3.sb run both ways first. Report goes to
# results/igg_method_comparison/ (picked up by fetch_reports.sh).
#   sbatch scripts/03b_compare_igg_methods.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_cutNrun/study_config/config.sh

POOLED=${SCRATCH}/results_pooled
"${TOOLS}/python" -I "${STUDY_DIR}/scripts/compare_igg_methods.py" \
  "${SAMPLE_SHEET}" "${STUDY_DIR}/study_config/sample_metadata.tsv" \
  "${OUT_DIR}/macs3" "${POOLED}/macs3" "${POOLED}/igg_background/pool_manifest.tsv" \
  "${TOOLS}/bedtools" "${OUT_DIR}/igg_method_comparison"
