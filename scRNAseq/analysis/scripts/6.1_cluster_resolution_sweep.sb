#!/bin/bash
#SBATCH --job-name=isl1_cluster_sweep
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=240G
#SBATCH --time=08:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/cluster_sweep.%j.out

# Step 6.1: Leiden resolution sweep on log, unintegrated -- see the .py docstring.
# amem (2026-11-08: acpu queue ~1,800 jobs deep, amem nearly empty). The amem QOS enforces
# MinMemory=240G, so 240G even though the job needs well under 60G (12 samples, ~46k cells).
# Submit from the repo root: sbatch analysis/scripts/6.1_cluster_resolution_sweep.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh

"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/6.1_cluster_resolution_sweep.py" \
  --normalized-h5ad "${OUT_DIR}/integration/merged_rna_normalized.h5ad" \
  --outdir "${OUT_DIR}/clustering"
