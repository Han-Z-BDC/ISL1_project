#!/bin/bash
#SBATCH --job-name=isl1_sub_report
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=12G
#SBATCH --time=00:20:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/sub_report.%j.out

# Step 7.1e: report + interactive 3D UMAP for a 7.1d compartment -- see the .py docstring. Needs 7.1d first.
# Submit from the repo root: sbatch analysis/scripts/7.1e_subcluster_report.sb D15 endocrine 0.6

set -euo pipefail
DAY="${1:?day}"; NAME="${2:?name}"; RES="${3:?subcluster resolution}"
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export OUT_DIR
"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/7.1e_subcluster_report.py" "${DAY}" "${NAME}" "${RES}"
