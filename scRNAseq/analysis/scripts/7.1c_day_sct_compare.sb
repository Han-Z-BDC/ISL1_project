#!/bin/bash
#SBATCH --job-name=isl1_day_sct_cmp
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=01:30:00
#SBATCH --array=0-2
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/day_sct_cmp.%A_%a.out

# Step 7.1c part 2: log1p vs the three SCT variants for one day (array 0-2 = D15, D22, D40): UMAPs and metrics.
# Runs after 7.1c_day_sct.sb (see that file for the submit lines).

set -euo pipefail
DAYS=(D15 D22 D40)
DAY="${DAYS[$SLURM_ARRAY_TASK_ID]}"
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh
export OUT_DIR SAMPLE_SHEET
echo "day ${DAY}"
"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/7.1c_day_sct_compare.py" "${DAY}"
