#!/bin/bash
#SBATCH --job-name=isl1_install_traj
#SBATCH --partition=acompile
#SBATCH --qos=compile
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=03:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/install_traj.%j.out

# One-off (2026-11-19): add the trajectory R packages for step 7.3 (D15 endocrine trajectory) to the single.cell env:
# slingshot (curves), condiments (control vs KO along the trajectory), tradeSeq (genes along pseudotime).
# Bioconductor for the env's R 4.4; update = FALSE so no installed package is changed (adds packages only).
# Run from the repo root: sbatch analysis/scripts/7.3_install_trajectory_r.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export PATH="$(dirname "${TOOLS}/R"):${PATH}"
"${TOOLS}/Rscript" -e '
options(repos = BiocManager::repositories(), Ncpus = 8)
pk <- c("slingshot", "condiments", "tradeSeq")
BiocManager::install(pk, update = FALSE, ask = FALSE, Ncpus = 8)
for (p in pk) cat(p, as.character(packageVersion(p)), "\n")
'
