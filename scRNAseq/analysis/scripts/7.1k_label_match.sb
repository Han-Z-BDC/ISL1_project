#!/bin/bash
#SBATCH --job-name=isl1_label_match
#SBATCH --partition=acpu
#SBATCH --qos=cpu-testing
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=00:59:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/label_match.%j.out

# Step 7.1k: do the labels of two days match (marker overlap + profile correlation) -- see the .py docstring.
# Needs 7.1h for both days. Submit from the repo root: sbatch analysis/scripts/7.1k_label_match.sb D22 D40

set -euo pipefail
A="${1:?usage: sbatch analysis/scripts/7.1k_label_match.sb <dayA> <dayB>}"; B="${2:?dayB}"
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export OUT_DIR REPO_DIR
"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/7.1k_label_match.py" "${A}" "${B}"
