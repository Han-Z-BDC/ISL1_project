#!/bin/bash
#SBATCH --job-name=isl1_integration_check
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=240G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/integration_check.%j.out

# Step 5.4b: unintegrated vs Harmony (+ scVI if 5.5 has finished) -- see the .py docstring.
# amem (2026-11-08: acpu queue ~1,800 jobs deep, amem nearly empty). The amem QOS enforces
# MinMemory=240G, so 240G even though the job needs well under 60G (12 samples, ~46k cells).
# Submit from the repo root: sbatch analysis/scripts/5.4b_integration_check.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh

"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/5.4b_integration_check.py" \
  --integration-dir "${OUT_DIR}/integration" \
  --outdir "${OUT_DIR}/integration_check"
