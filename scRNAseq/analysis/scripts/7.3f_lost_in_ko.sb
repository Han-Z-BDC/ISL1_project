#!/bin/bash
#SBATCH --job-name=isl1_lost_in_ko
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=15G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/lost_in_ko.%j.out

# Step 7.3f: control alpha / beta fate-program genes (CellRank drivers, 7.3d) not switched on in KO where it stops --
# see the .py docstring. Needs 7.3d.
# Runs in the separate CellRank env (CELLRANK_ENV in study_config/config.sh).
# Run from the repo root: sbatch analysis/scripts/7.3f_lost_in_ko.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export OUT_DIR REPO_DIR
"${CELLRANK_ENV}/bin/python" "${REPO_DIR}/analysis/scripts/7.3f_lost_in_ko.py"
