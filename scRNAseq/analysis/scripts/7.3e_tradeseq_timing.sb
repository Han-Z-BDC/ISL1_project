#!/bin/bash
#SBATCH --job-name=isl1_tradeseq_timing
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=60G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/tradeseq_timing.%j.out

# TEST: tradeSeq fitGAM time per gene on D15 (see the .R header). Run from the repo root.
set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export OUT_DIR REPO_DIR
"${TOOLS}/Rscript" "${REPO_DIR}/analysis/scripts/7.3e_tradeseq_timing.R"
