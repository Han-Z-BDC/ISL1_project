#!/bin/bash
#SBATCH --job-name=isl1_env_cellrank
#SBATCH --partition=acompile
#SBATCH --qos=compile
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=02:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/env_cellrank.%j.out

# One-off (user, 2026-11-19): a separate env for CellRank 2 (step 7.3d), so the single.cell env is not changed
# (CellRank 2.0.7 pins Jinja2 < 3.1; single.cell has 3.1.5). Built with the lab micromamba bootstrap (no miniforge
# module on Alpine), conda-forge + bioconda only. Env path: CELLRANK_ENV in study_config/config.sh.
# Run from the repo root: sbatch analysis/scripts/7.3_install_cellrank.sb   (rerun rebuilds the env from scratch)

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export MAMBA_ROOT_PREFIX=/projects/hzhu10@xsede.org/software/micromamba_bootstrap
MM="${MAMBA_ROOT_PREFIX}/bin/micromamba"
rm -rf "${CELLRANK_ENV}"
"${MM}" create -y -p "${CELLRANK_ENV}" --override-channels -c conda-forge -c bioconda \
  "python=3.11" "cellrank>=2" scvelo scanpy anndata loompy plotly matplotlib pandas numpy scipy h5py
"${CELLRANK_ENV}/bin/python" -c "import cellrank as cr, scvelo as scv, scanpy as sc, anndata as ad, plotly; \
print('cellrank', cr.__version__, '| scvelo', scv.__version__, '| scanpy', sc.__version__, '| anndata', ad.__version__)"
