#!/bin/bash
#SBATCH --job-name=isl1_label_plots
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=20G
#SBATCH --time=00:30:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/label_plots.%j.out

# Step 7.1i: label and marker-gene UMAPs split by genotype -- see the .py docstring. Needs 7.1h for that day first.
# Submit from the repo root: sbatch analysis/scripts/7.1i_label_plots.sb D22 [GENE,GENE,...]

set -euo pipefail
DAY="${1:?day}"
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/scRNAseq/study_config/config.sh
export OUT_DIR REPO_DIR
"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/7.1i_label_plots.py" "${DAY}" ${2:+"$2"}
