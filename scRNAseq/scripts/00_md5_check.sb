#!/bin/bash
#SBATCH --job-name=isl1_sc_md5
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=4G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/md5_check.%j.out
#SBATCH --error=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/md5_check.%j.err

# Step 0: verify the Admera delivery against its md5.txt. Run 2026-10-11 (job 33679918) on the
# whole delivery (34 files: scRNA + CUT&RUN, all OK) before the CUT&RUN fastqs were moved to
# raw_data/ISL1_cut_N_run/7535-0002-10082026_215649 (2026-10-16); md5.txt here now lists only the 2 scRNA files. md5sum is single-threaded per file,
# so 4 files are checked in parallel. Non-zero exit if any file fails.

set -euo pipefail

source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh

# Optional argument: folder to check (default RAW_DIR). Used 2026-10-16 to re-check both the
# scRNA folder and raw_data/ISL1_cut_N_run/7535-0002-10082026_215649 after the CUT&RUN move:
#   sbatch scripts/00_md5_check.sb /pl/active/ZhuLab_BDC/raw_data/ISL1_cut_N_run/7535-0002-10082026_215649
CHECK_DIR="${1:-${RAW_DIR}}"
TAG=$(basename "$(dirname "${CHECK_DIR}")")
cd "${CHECK_DIR}"
echo "[$(date)] Checking $(wc -l < md5.txt) files in ${CHECK_DIR}"
xargs -P "${SLURM_CPUS_PER_TASK}" -L 1 sh -c 'echo "$0  $1" | md5sum -c -' < md5.txt | sort > "${LOGS}/md5_check.${TAG}.${SLURM_JOB_ID}.result"

cat "${LOGS}/md5_check.${TAG}.${SLURM_JOB_ID}.result"
n_ok=$(grep -c ": OK$" "${LOGS}/md5_check.${TAG}.${SLURM_JOB_ID}.result" || true)
echo "[$(date)] ${n_ok}/$(wc -l < md5.txt) OK"
[ "${n_ok}" -eq "$(wc -l < md5.txt)" ]
