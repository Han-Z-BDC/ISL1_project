#!/bin/bash
#SBATCH --job-name=isl1_cluster_de
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=240G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/cluster_de.%j.out

# Step 7.2: KO vs ctr DE inside one cluster (pseudobulk edgeR) -- see the .py docstring.
# amem: the amem QOS enforces MinMemory=240G (the job itself needs < 40G).
# Submit from the repo root: sbatch analysis/scripts/7.2_cluster_de.sb D15 harmony 0.8 2

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh
export OUT_DIR TOOLS
"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/7.2_cluster_de.py" "$@"
