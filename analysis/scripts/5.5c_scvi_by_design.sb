#!/bin/bash
#SBATCH --job-name=isl1_scvi_design
#SBATCH --partition=ah200
#SBATCH --qos=gpu-normal
#SBATCH --gres=gpu:h200_2g.35gb:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/scvi_design.%j.out

# Step 5.5c: scVI by study design (no batch / diff_batch / per sample) -- see the .py docstring.
# Same GPU slice as pipeline 5.5 (ah200 MIG 2g.35gb); 3 models instead of 2, so 4 h.
# Submit from the repo root: sbatch analysis/scripts/5.5c_scvi_by_design.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh

"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/5.5c_scvi_by_design.py" \
  --merged-rna-h5ad "${OUT_DIR}/integration/merged_rna_raw.h5ad" \
  --outdir "${OUT_DIR}/integration"
