#!/bin/bash
#SBATCH --job-name=isl1_day_merged
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=30G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_scRNAseq/logs/day_merged.%j.out

# Step 7.1: one day's 4 samples merged, no batch correction -- see the .py docstring.
# Submit from the repo root: sbatch analysis/scripts/7.1_day_merged.sb D15

set -euo pipefail
DAY="${1:?usage: sbatch analysis/scripts/7.1_day_merged.sb <D15|D22|D40>}"
source /pl/active/ZhuLab_BDC/GitHub/ISL1_scRNAseq/study_config/config.sh
export OUT_DIR SAMPLE_SHEET
"${TOOLS}/python" "${REPO_DIR}/analysis/scripts/7.1_day_merged.py" "${DAY}"
