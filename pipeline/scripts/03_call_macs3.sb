#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=cutnrun_macs3
#SBATCH --output=logs/macs3.%j.out

# Peak calling: every TF sample's duplicate-RETAINED BAM (from 01_align.sb)
# against its IgG background (deduplicated, from 02_build_igg_background.sb).
# Which background depends on IGG_METHOD: each sample's own matched control,
# or the one shared pooled background -- either way it's already
# deduplicated by the time it gets here.

set -euo pipefail
P=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "${P}/config.sh"

BAM=${OUT_DIR}/bam
BG=${OUT_DIR}/igg_background
OUT=${OUT_DIR}/macs3
mkdir -p "${OUT}" "${P}/logs"

case "${IGG_METHOD}" in
  matched) : ;;
  pooled)
    control_bam="${BG}/pooled_deduplicated_IgG.bam"
    [[ -s "${control_bam}" ]] || { echo "ERROR: missing ${control_bam} -- run 02_build_igg_background.sb first" >&2; exit 1; }
    ;;
  *) echo "ERROR: IGG_METHOD must be 'matched' or 'pooled', got '${IGG_METHOD}'" >&2; exit 1 ;;
esac

while IFS=$'\t' read -r library sample role control replicate; do
  [[ "${library}" == library_id ]] && continue
  [[ "${role}" == TF ]] || continue

  target="${BAM}/${sample}.filtered.bam"
  [[ -s "${target}" ]] || { echo "ERROR: missing ${target}" >&2; exit 1; }

  if [[ "${IGG_METHOD}" == matched ]]; then
    control_bam="${BG}/${control}.dedup.bam"
    [[ -s "${control_bam}" ]] || { echo "ERROR: missing ${control_bam} -- run 02_build_igg_background.sb first" >&2; exit 1; }
  fi

  echo "calling peaks: ${sample} vs $(basename "${control_bam}")"
  "${TOOLS}/macs3" callpeak -t "${target}" -c "${control_bam}" -f BAMPE -g hs \
    -n "${sample}" -q "${MACS_QVALUE}" --call-summits --keep-dup all -B --outdir "${OUT}"

  "${TOOLS}/bedtools" intersect -v -a "${OUT}/${sample}_peaks.narrowPeak" -b "${BLACKLIST}" \
    > "${OUT}/${sample}_peaks.filtered.narrowPeak"
  "${TOOLS}/bedtools" intersect -v -a "${OUT}/${sample}_summits.bed" -b "${BLACKLIST}" \
    > "${OUT}/${sample}_summits.filtered.bed"

  n_raw=$(wc -l < "${OUT}/${sample}_peaks.narrowPeak")
  n_filtered=$(wc -l < "${OUT}/${sample}_peaks.filtered.narrowPeak")
  echo "SUMMARY ${sample}: raw_peaks=${n_raw} blacklist_filtered_peaks=${n_filtered}"
done < "${SAMPLE_SHEET}"
