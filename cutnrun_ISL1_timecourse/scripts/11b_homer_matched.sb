#!/bin/bash
#SBATCH --job-name=tc_homer_m
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_cutnrun_timecourse/logs/homer_m.%A_%a.out

# Step 11b: HOMER findMotifsGenome.pl with composition-matched backgrounds (step 11a); same settings
# as step 10b (-size given, -mask, known + de novo 8/10/12 bp, 12 threads), custom -bg (HOMER still
# normalizes GC). Array index: day = index / 3 (D15, D18, D22); run = index % 3:
#   0 promoter_vs_promoters  promoter peaks (within 1 kb of a TSS) vs the promoter pool        (A)
#   1 distal_vs_genome       distal peaks vs genome windows > 1 kb from a TSS                  (A)
#   2 all_vs_matched         all peaks vs 3 x random windows of the same genomic classes        (B)
# Output: homer/matched/<day>_<run>/
#   sbatch --array=0-8 --dependency=afterok:<11a job> scripts/11b_homer_matched.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_timecourse/study_config/config.sh
: "${SLURM_ARRAY_TASK_ID:?ERROR: submit as an array}"
DAYS=(D15 D18 D22); RUNS=(promoter_vs_promoters distal_vs_genome all_vs_matched)
day=${DAYS[$((SLURM_ARRAY_TASK_ID / 3))]}; run=${RUNS[$((SLURM_ARRAY_TASK_ID % 3))]}
H=${OUT_DIR}/homer; IN=${H}/matched/inputs; O=${H}/matched/${day}_${run}
P=${SCRATCH}/homer_preparsed/matched_${day}_${run}
case ${run} in
  promoter_vs_promoters) tg=${IN}/${day}.promoter.bed; bg=${IN}/${day}.bg_promoter.bed ;;
  distal_vs_genome)      tg=${IN}/${day}.distal.bed;   bg=${IN}/${day}.bg_distal.bed ;;
  all_vs_matched)        tg=${H}/inputs/${day}.target.bed; bg=${IN}/${day}.bg_matched.bed ;;
esac
export PATH=${HOMER_BIN}:${PATH}
rm -rf "${O}" "${P}"; mkdir -p "${P}"
echo "${day} ${run}: $(wc -l < "${tg}") targets, $(wc -l < "${bg}") background"
findMotifsGenome.pl "${tg}" "${HOMER_FA}" "${O}" -size given -mask -len 8,10,12 -p "${SLURM_CPUS_PER_TASK}" \
  -preparsedDir "${P}" -bg "${bg}"
rm -rf "${P}"
[[ -s "${O}/knownResults.txt" ]] || { echo "ERROR: no knownResults.txt in ${O}" >&2; exit 1; }
head -6 "${O}/knownResults.txt" | cut -f1,3,7,9
