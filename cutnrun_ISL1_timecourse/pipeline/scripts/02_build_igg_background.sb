#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=cutnrun_igg_bg
#SBATCH --output=logs/igg_background.%j.out

# Builds the IgG background BAM(s) that 03_call_macs3.sb calls peaks against.
# Controlled by IGG_METHOD in config.sh:
#
#   matched  each TF sample's own control_sample (from samples.tsv) is
#            deduplicated and used as that sample's background, 1:1.
#
#   pooled   POOL_IGG_SAMPLES are each deduplicated, downsampled to a shared
#            fragment target, and merged into one background used for every
#            TF sample.
#
# Either way, the output IgG BAM(s) are deduplicated -- only the target
# (TF) BAMs from 01_align.sb keep their duplicates.

set -euo pipefail
# Slurm runs a copy of this script from its spool dir, so BASH_SOURCE cannot locate the repo;
# use the directory sbatch was called from, which must be the repo root.
P="${SLURM_SUBMIT_DIR:?ERROR: SLURM_SUBMIT_DIR not set -- submit via sbatch from the repo root, not run directly}"
[[ -f "${P}/config.sh" ]] || { echo "ERROR: no config.sh in ${P} -- submit from the repo root" >&2; exit 1; }
source "${P}/config.sh"

T=${SLURM_CPUS_PER_TASK:-4}
BAM=${OUT_DIR}/bam
BG=${OUT_DIR}/igg_background
mkdir -p "${BG}" "${P}/logs"

dedup_one () {
  # $1 = sample name -> writes ${BG}/${1}.dedup.bam
  local sample=$1
  local in="${BAM}/${sample}.filtered.bam"
  local out="${BG}/${sample}.dedup.bam"
  [[ -s "${in}" ]] || { echo "ERROR: missing ${in}" >&2; exit 1; }
  "${TOOLS}/samtools" view -@ "${T}" -b -F 1024 -o "${out}" "${in}"
  "${TOOLS}/samtools" index -@ "${T}" "${out}"
  echo "deduplicated: ${sample} -> ${out}"
}

case "${IGG_METHOD}" in

  matched)
    # One dedup pass per unique control_sample referenced by a TF row.
    controls=$(awk -F'\t' 'NR>1 && $3=="TF" {print $4}' "${SAMPLE_SHEET}" | sort -u)
    [[ -n "${controls}" ]] || { echo "ERROR: no TF rows with a control_sample found in ${SAMPLE_SHEET}" >&2; exit 1; }
    while read -r control; do
      dedup_one "${control}"
    done <<< "${controls}"
    ;;

  pooled)
    (( ${#POOL_IGG_SAMPLES[@]} == ${#POOL_IGG_SEEDS[@]} )) \
      || { echo "ERROR: POOL_IGG_SAMPLES and POOL_IGG_SEEDS must be the same length" >&2; exit 1; }

    manifest=${BG}/pool_manifest.tsv
    echo -e "control\tfragments_input\tfragments_deduplicated\ttarget_fragments\tsampling_fraction\tfragments_contributed" > "${manifest}"

    downsampled_bams=()
    for i in "${!POOL_IGG_SAMPLES[@]}"; do
      sample=${POOL_IGG_SAMPLES[$i]}
      seed=${POOL_IGG_SEEDS[$i]}
      in="${BAM}/${sample}.filtered.bam"
      [[ -s "${in}" ]] || { echo "ERROR: missing ${in}" >&2; exit 1; }

      n_input=$("${TOOLS}/samtools" view -@ "${T}" -c -f 64 "${in}")
      dedup="${BG}/${sample}.dedup.bam"
      "${TOOLS}/samtools" view -@ "${T}" -b -F 1024 -o "${dedup}" "${in}"
      n_dedup=$("${TOOLS}/samtools" view -@ "${T}" -c -f 64 "${dedup}")

      (( n_dedup >= POOL_TARGET_FRAGMENTS )) \
        || { echo "ERROR: ${sample} has only ${n_dedup} deduplicated fragments, below POOL_TARGET_FRAGMENTS=${POOL_TARGET_FRAGMENTS}" >&2; exit 1; }

      frac=$(awk -v t="${POOL_TARGET_FRAGMENTS}" -v n="${n_dedup}" 'BEGIN{printf "%.8f", t/n}')
      down="${BG}/${sample}.equal_contribution.bam"
      "${TOOLS}/samtools" view -@ "${T}" -b -s "${seed}.${frac#0.}" -o "${down}" "${dedup}"
      "${TOOLS}/samtools" index -@ "${T}" "${down}"
      n_contributed=$("${TOOLS}/samtools" view -@ "${T}" -c -f 64 "${down}")

      echo -e "${sample}\t${n_input}\t${n_dedup}\t${POOL_TARGET_FRAGMENTS}\t${frac}\t${n_contributed}" >> "${manifest}"
      downsampled_bams+=("${down}")
    done

    pooled="${BG}/pooled_deduplicated_IgG.bam"
    "${TOOLS}/samtools" merge -@ "${T}" -f "${pooled}" "${downsampled_bams[@]}"
    "${TOOLS}/samtools" index -@ "${T}" "${pooled}"
    "${TOOLS}/samtools" flagstat -@ "${T}" "${pooled}" > "${BG}/pooled_deduplicated_IgG.flagstat.txt"

    n_pooled=$("${TOOLS}/samtools" view -@ "${T}" -c -f 64 "${pooled}")
    echo -e "pooled_total\t${n_pooled}" >> "${manifest}"
    echo "pooled background complete: ${pooled} (${n_pooled} fragments)"
    ;;

  *)
    echo "ERROR: IGG_METHOD must be 'matched' or 'pooled', got '${IGG_METHOD}'" >&2
    exit 1
    ;;
esac
