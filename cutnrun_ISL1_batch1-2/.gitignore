results/
logs/

# HTML reports live in the local (Mac) review copy only -- see scripts/fetch_reports.sh.
reports/

# pipeline/config.sh and pipeline/logs are symlinks made by study_config/setup_links.sh.
/pipeline/config.sh
/pipeline/logs

