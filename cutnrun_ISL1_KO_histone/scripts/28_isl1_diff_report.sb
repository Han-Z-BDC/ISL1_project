#!/bin/bash
#SBATCH --job-name=isl1_diff_report
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=00:30:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/isl1_diff_report.%j.out

# Step 28: HTML report of ISL1 differential binding over time (steps 26-27; agreed 2026-11-12).
# Output: results/isl1_diff/report.html
#   sbatch --dependency=afterok:<27 job> scripts/28_isl1_diff_report.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
"${TOOLS}/python" "${STUDY_DIR}/scripts/isl1_diff_report.py" "${OUT_DIR}/isl1_diff" "${OUT_DIR}/isl1_diff/report.html"
