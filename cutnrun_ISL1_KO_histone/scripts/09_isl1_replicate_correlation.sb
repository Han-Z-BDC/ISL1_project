#!/bin/bash
#SBATCH --job-name=b3_repcor
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/repcor.%j.out

# Step 9: ISL1 replicate correlation and PCA (H3CTR, 4 days x 2 replicates), with the 8 block IgGs
# as background.
#   - peaks: step 03 MACS3 calls (q 0.01, blacklist filtered), summit rows collapsed, chr1-22/X/Y
#   - peak sets: per-day union (rep1 + rep2 merged) and all-sample union (all 8 ISL1 replicates)
#   - counts: fragments per peak, featureCounts -p --countReadPairs, duplicates kept; ISL1 and IgG
#     both from results/bam/<sample>.filtered.bam (IgG with duplicates too, so both are
#     processed alike)
#   - scripts/replicate_correlation.py: log2(CPM + 1) with CPM by all counted fragments; Pearson
#     (log2 CPM) and Spearman (counts); clustered heatmaps; PCA (centered, not scaled) on all
#     peaks and on the 5,000 most variable; report.html
# Output: results/qc/replicate_correlation/isl1/
#   sbatch scripts/09_isl1_replicate_correlation.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
BT=${TOOLS}/bedtools
O=${OUT_DIR}/qc/replicate_correlation/isl1
mkdir -p "${O}/peaks" "${O}/counts"

# sample_metadata.tsv: sample_name library_id day line replicate antibody batch_folder
mapfile -t LIBS < <(awk -F'\t' -v L=" ${REPRO_LINES} " 'NR>1 && index(L, " "$4" ") && $6=="ISL1" {print $3"\t"$5"\t"$1}' "${METADATA}" \
  | sort -t$'\t' -k1,1V -k2,2n | cut -f3)
(( ${#LIBS[@]} == 8 )) || { echo "ERROR: expected 8 ISL1 libraries, found ${#LIBS[@]}" >&2; exit 1; }
BAMS=(); : > "${O}/samples.tsv"
for s in "${LIBS[@]}"; do
  # samples.tsv: library_id sample_name role control_sample replicate
  igg=$(awk -F'\t' -v s="${s}" '$2==s {print $4}' "${SAMPLE_SHEET}")
  for x in "${s}" "${igg}"; do
    [[ -s "${OUT_DIR}/bam/${x}.filtered.bam" ]] || { echo "ERROR: missing ${OUT_DIR}/bam/${x}.filtered.bam" >&2; exit 1; }
  done
  echo -e "${s}\tISL1\t${igg}" >> "${O}/samples.tsv"
done
for s in "${LIBS[@]}"; do BAMS+=("${OUT_DIR}/bam/${s}.filtered.bam"); done
while IFS=$'\t' read -r s ab igg; do BAMS+=("${OUT_DIR}/bam/${igg}.filtered.bam"); done < "${O}/samples.tsv"
echo "libraries (ISL1 then IgG): ${BAMS[*]##*/}"

regions () {
  awk 'BEGIN{OFS="\t"} $1 ~ /^chr([0-9]+|X|Y)$/ {print $1, $2, $3}' "${OUT_DIR}/macs3/$1_peaks.filtered.narrowPeak" \
    | sort -k1,1 -k2,2n | "${BT}" merge -i -
}
for s in "${LIBS[@]}"; do regions "${s}" > "${O}/peaks/${s}.regions.bed"; done

saf () {
  # $1 = name, stdin = bed3 -> ${O}/peaks/$1.saf and .bed
  sort -k1,1 -k2,2n | "${BT}" merge -i - > "${O}/peaks/$1.union.bed"
  awk -v n="$1" 'BEGIN{OFS="\t"; print "GeneID", "Chr", "Start", "End", "Strand"} {print n"_"NR, $1, $2+1, $3, "+"}' \
    "${O}/peaks/$1.union.bed" > "${O}/peaks/$1.saf"
  echo "$1: $(wc -l < "${O}/peaks/$1.union.bed") union peaks"
}
for d in $(cut -f1 "${O}/samples.tsv" | cut -d_ -f1 | uniq); do
  cat "${O}/peaks/${d}"_*_ISL1.regions.bed | saf "${d}"
done
cat "${O}"/peaks/*_ISL1.regions.bed | saf all

for set in $(cut -f1 "${O}/samples.tsv" | cut -d_ -f1 | uniq) all; do
  "${FEATURECOUNTS}" -T "${SLURM_CPUS_PER_TASK:-8}" -p --countReadPairs -F SAF -a "${O}/peaks/${set}.saf" \
    -o "${O}/counts/${set}.counts.txt" "${BAMS[@]}" 2> "${O}/counts/${set}.featureCounts.log"
  echo "counted ${set}"
done

"${TOOLS}/python3" "${STUDY_DIR}/scripts/replicate_correlation.py" "${O}"
ls -la "${O}"
