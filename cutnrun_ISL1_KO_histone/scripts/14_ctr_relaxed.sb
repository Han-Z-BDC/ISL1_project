#!/bin/bash
#SBATCH --job-name=ctr_relaxed
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/ctr_relaxed.%A_%a.out

# Step 14: relaxed MACS3 calls for the earlier control ISL1 libraries (Ctr rep3 onward, step 13),
# against each library's own block IgG. These are the inputs for the multi-replicate overlap
# and IDR sets of step 15. One array task per row of study_config/ctr_matched_samples.tsv (7).
# Same settings as step 04: BAMPE, p RELAXED_P, --keep-dup all, no summits, top CAP_TF peaks by
# p value, blacklist filtered. Batch 3 rep1/rep2 already have theirs (step 04).
# Output: results/ctr_multi/relaxed/<sample>.relaxed.narrowPeak
#   sbatch --array=0-6 scripts/14_ctr_relaxed.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_KO_histone_cutNrun/study_config/config.sh
: "${SLURM_ARRAY_TASK_ID:?ERROR: submit as an array, --array=0-6}"
MAP=${STUDY_DIR}/study_config/ctr_matched_samples.tsv

# ctr_matched_samples.tsv: sample ... isl1_bam (11) igg_bam (12)
row=$(awk -F'\t' -v i="${SLURM_ARRAY_TASK_ID}" 'NR == i + 2 {print $1"\t"$11"\t"$12}' "${MAP}")
[[ -n "${row}" ]] || { echo "ERROR: no row at index ${SLURM_ARRAY_TASK_ID} in ${MAP}" >&2; exit 1; }
IFS=$'\t' read -r sample target control_bam <<< "${row}"
for f in "${target}" "${control_bam}"; do [[ -s "${f}" ]] || { echo "ERROR: missing ${f}" >&2; exit 1; }; done

REL=${OUT_DIR}/ctr_multi/relaxed
mkdir -p "${REL}"
echo "relaxed call: ${sample} vs $(basename "${control_bam}")"
"${TOOLS}/macs3" callpeak -t "${target}" -c "${control_bam}" -f BAMPE -g hs \
  -n "${sample}" -p "${RELAXED_P}" --keep-dup all --outdir "${REL}"
sort -k8,8gr "${REL}/${sample}_peaks.narrowPeak" | awk -v n="${CAP_TF}" 'NR <= n' \
  | "${TOOLS}/bedtools" intersect -v -a - -b "${BLACKLIST}" > "${REL}/${sample}.relaxed.narrowPeak"
rm -f "${REL}/${sample}_peaks.narrowPeak" "${REL}/${sample}_peaks.xls" "${REL}/${sample}_summits.bed"
echo "RELAXED ${sample}: $(wc -l < "${REL}/${sample}.relaxed.narrowPeak") peaks (p ${RELAXED_P}, top ${CAP_TF}, blacklist filtered)"
