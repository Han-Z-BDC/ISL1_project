#!/bin/bash
#SBATCH --job-name=isl1_diffbind
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/isl1_diffbind.%j.out

# Step 27: ISL1 differential binding over time (agreed 2026-11-12). Control ISL1 only, the trio
# libraries (D15 rep1/3/4, D18 rep1/3/4, D22 rep2/4/5), design ~ batch + day (batch 3 vs earlier),
# contrasts D18 vs D15, D22 vs D18, D22 vs D15. Sites: step 26 (401 bp), minus an IgG greylist.
#   main   DiffBind (DESeq2), background-bin and RLE normalization, reported side by side
#   check  plain DESeq2 on featureCounts counts (counted here, independently of DiffBind), same
#          design, size factors from 15 kb genome bins (background) or from the sites (RLE)
# FDR < 0.05; counts also with |log2FC| >= 1. scripts/isl1_diffbind.R does the analysis.
# Output: results/isl1_diff/ (see isl1_diffbind.R)
#   sbatch --dependency=afterok:<26 job> scripts/27_isl1_diffbind.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
D=${OUT_DIR}/isl1_diff
FC=${D}/featurecounts
mkdir -p "${FC}"
SITES=${D}/sites/sites_401bp.bed
[[ -s "${SITES}" ]] || { echo "ERROR: missing ${SITES} (step 26)" >&2; exit 1; }

# trio libraries, in a fixed order (day, replicate)
awk -F'\t' 'NR>1 && (($1=="D15"||$1=="D18") && ($2==1||$2==3||$2==4) || $1=="D22" && ($2==2||$2==4||$2==5))' \
  "${STUDY_DIR}/study_config/ctr_replicates.tsv" | sort -t$'\t' -k1,1V -k2,2n > "${D}/trio.tsv"
[[ $(wc -l < "${D}/trio.tsv") -eq 9 ]] || { echo "ERROR: expected 9 trio libraries" >&2; exit 1; }
mapfile -t BAMS < <(cut -f6 "${D}/trio.tsv")

# featureCounts (fragments, duplicates kept) on the sites and on 15 kb bins of chr1-22/X/Y
awk 'BEGIN{OFS="\t"; print "GeneID","Chr","Start","End","Strand"} {print $4, $1, $2 + 1, $3, "+"}' "${SITES}" > "${FC}/sites.saf"
awk 'BEGIN{OFS="\t"; print "GeneID","Chr","Start","End","Strand"} $1 ~ /^chr([0-9]+|X|Y)$/ {
       for (s = 0; s < $2; s += 15000) { e = s + 15000; if (e > $2) e = $2; print $1"_"s, $1, s + 1, e, "+" } }' \
  "${OUT_DIR}/isl1_consensus/genome.txt" > "${FC}/bins15k.saf"
for set in sites bins15k; do
  "${FEATURECOUNTS}" -T 12 -p --countReadPairs -F SAF -a "${FC}/${set}.saf" -o "${FC}/${set}.counts.txt" "${BAMS[@]}"
done

DB_CORES=4 "${DIFFBIND_TOOLS}/Rscript" "${STUDY_DIR}/scripts/isl1_diffbind.R" "${D}"
