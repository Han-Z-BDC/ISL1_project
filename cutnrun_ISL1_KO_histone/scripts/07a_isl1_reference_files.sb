#!/bin/bash
#SBATCH --job-name=isl1_cons_ref
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/isl1_cons_ref.%j.out

# Step 7a: the two helper files of step 07 on their own, for runs that skip 07 (steps 08, 11 and
# 15 read them). Same commands as step 07:
#   reference.bed  ISL1_REFERENCE_PEAKS (earlier D15 Ctr conservative ISL1 set), cols 1-3, sorted
#   genome.txt     chromosome lengths from the first ISL1 BAM header, in lexical order
# Output: results/isl1_consensus/{reference.bed,genome.txt}
#   sbatch --dependency=afterok:<01 job> scripts/07a_isl1_reference_files.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
C=${OUT_DIR}/isl1_consensus
mkdir -p "${C}"
[[ -s "${ISL1_REFERENCE_PEAKS}" ]] || { echo "ERROR: missing ${ISL1_REFERENCE_PEAKS}" >&2; exit 1; }
cut -f1-3 "${ISL1_REFERENCE_PEAKS}" | sort -k1,1 -k2,2n > "${C}/reference.bed"
"${TOOLS}/samtools" view -H "${OUT_DIR}/bam/$(awk -F'\t' 'NR>1 && $6=="ISL1" {print $1; exit}' "${METADATA}").filtered.bam" \
  | awk -F'\t' '$1=="@SQ" {sub("SN:","",$2); sub("LN:","",$3); print $2"\t"$3}' | sort -k1,1 > "${C}/genome.txt"
wc -l "${C}/reference.bed" "${C}/genome.txt"
