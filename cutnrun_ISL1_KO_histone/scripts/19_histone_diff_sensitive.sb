#!/bin/bash
#SBATCH --job-name=hist_sens
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/hist_sens.%j.out

# Step 19 (histone differential, more sensitive KO vs Ctr; agreed 2026-11-09): for one mark,
# on top of step 17 (scripts/histone_deseq2_sensitive.R):
#   1. calls on padj alone (no fold-change cut); a 1.5-fold lfcThreshold test alongside
#   2. a KO effect shared across days: ~ rep + day + genotype, genotype tested on all libraries
#   4. 500 bp windows tiled over the step 16 regions (bedtools makewindows, windows < 100 bp
#      dropped), each fragment counted in the window it overlaps most (featureCounts
#      --largestOverlap); same tests per window, then window p values combined per region (Simes)
#      and BH across regions, as in csaw
# Output: results/diff/<mark>/sensitive/ (and win500/ for the window counts)
#   MARK=H3K27ac sbatch --export=ALL scripts/19_histone_diff_sensitive.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
MARK=${MARK:-H3K27ac}
WIN=${WIN:-500}
D=${OUT_DIR}/diff/${MARK}
W=${D}/win${WIN}
for f in "${D}/regions.bed" "${D}/samples.tsv" "${D}/counts.txt" "${D}/deseq2/dds_group.rds"; do
  [[ -s "${f}" ]] || { echo "ERROR: missing ${f} -- run steps 16-17 first" >&2; exit 1; }
done
mkdir -p "${W}"

# Windows: id = <region>_w<n>
cut -f1-4 "${D}/regions.bed" | "${TOOLS}/bedtools" makewindows -b - -w "${WIN}" -i src \
  | awk 'BEGIN{OFS="\t"} $3 - $2 >= 100 {n[$4]++; print $1, $2, $3, $4"_w"n[$4], $4}' > "${W}/windows.bed"
awk 'BEGIN{OFS="\t"; print "GeneID", "Chr", "Start", "End", "Strand"} {print $4, $1, $2 + 1, $3, "+"}' "${W}/windows.bed" > "${W}/windows.saf"
echo "windows: $(wc -l < "${W}/windows.bed") (${WIN} bp, over $(wc -l < "${D}/regions.bed") regions)"

mapfile -t BAMS < <(tail -n +2 "${D}/samples.tsv" | cut -f6)
"${FEATURECOUNTS}" -T "${SLURM_CPUS_PER_TASK:-12}" -p --countReadPairs --largestOverlap -F SAF -a "${W}/windows.saf" \
  -o "${W}/counts.txt" "${BAMS[@]}" 2> "${W}/featureCounts.log"
grep -E "Total fragments|Successfully assigned" "${W}/featureCounts.log" | head -24

RBIN=$(dirname "${FEATURECOUNTS}")
"${RBIN}/Rscript" "${STUDY_DIR}/scripts/histone_deseq2_sensitive.R" "${D}" "${W}"
