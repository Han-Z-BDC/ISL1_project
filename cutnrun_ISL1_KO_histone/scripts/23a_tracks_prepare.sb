#!/bin/bash
#SBATCH --job-name=tracks_prep
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/tracks_prep.%j.out

# Step 23a (browser tracks, part 1; agreed 2026-11-09): library table and scale factors.
#   - libraries: scripts/tracks_manifest.py (70 BAMs: histone, ISL1 controls, their IgGs)
#   - scale = 1e6 / (G x size factor): CPM at the mean library size, corrected with DESeq2
#     median-of-ratios size factors on the regions the analyses used, so tracks show the same
#     differences as the statistics. Size factors per kind, over all its libraries:
#       H3K27ac / H3K27me3: the step 16 union regions (D9 libraries included)
#       ISL1: union of the kept control sets (macs3_ge2, idr_any_pair) and the D9 two-replicate
#             consensus (built here from the matched q 0.01 calls, as step 11 option A)
#     G = geometric mean of the kind's library fragments. IgG: plain CPM (1e6 / fragments).
#   - fragments = mapped reads / 2 (samtools idxstats; all BAMs are filtered properly paired)
# Output: results/tracks/sf/{libraries.tsv,scale_factors.tsv,<kind>.counts.txt}
#   sbatch scripts/23a_tracks_prepare.sb   (then 23b array, 23c)

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
T=${OUT_DIR}/tracks; S=${T}/sf
mkdir -p "${S}"
ST=${TOOLS}/samtools; BT=${TOOLS}/bedtools

"${TOOLS}/python3" -I "${STUDY_DIR}/scripts/tracks_manifest.py" "${METADATA}" "${STUDY_DIR}/study_config/ctr_replicates.tsv" "${OUT_DIR}" "${S}/libraries.tsv"

# Index any BAM without one; fragments per BAM
echo -e "bam\tfragments" > "${S}/fragments.tsv"
tail -n +2 "${S}/libraries.tsv" | cut -f3 | while read -r b; do
  [[ -s "${b}" ]] || { echo "ERROR: missing ${b}" >&2; exit 1; }
  [[ -s "${b}.bai" || -s "${b%.bam}.bai" ]] || "${ST}" index -@ 12 "${b}"
  echo -e "${b}\t$("${ST}" idxstats "${b}" | awk '{m+=$3} END{printf "%d", m/2}')" >> "${S}/fragments.tsv"
done

# D9 control ISL1, two-replicate consensus (as step 11 option A, matched IgG): each replicate's
# q 0.01 calls (chr1-22/X/Y) merged, regions holding a call from both replicates; columns chr,
# start, end, name, rep1 max -log10 p, rep2 max -log10 p, sum
canon () { awk -F'\t' '$1 ~ /^chr([0-9]+|X|Y)$/' "$@"; }
for r in 1 2; do
  canon "${OUT_DIR}/macs3/D9_H3CTR_rep${r}_ISL1_peaks.filtered.narrowPeak" | awk 'BEGIN{OFS="\t"} {print $1, $2, $3, $8}' \
    | sort -k1,1 -k2,2n | "${BT}" merge -i - -c 4 -o max > "${S}/D9_rep${r}.regions.bed"
done
{ awk 'BEGIN{OFS="\t"} {print $1, $2, $3, 1}' "${S}/D9_rep1.regions.bed"; awk 'BEGIN{OFS="\t"} {print $1, $2, $3, 2}' "${S}/D9_rep2.regions.bed"; } \
  | sort -k1,1 -k2,2n | "${BT}" merge -i - -c 4 -o count_distinct | awk 'BEGIN{OFS="\t"} $4 == 2 {print $1, $2, $3}' \
  | "${BT}" map -a - -b "${S}/D9_rep1.regions.bed" -c 4 -o max | "${BT}" map -a - -b "${S}/D9_rep2.regions.bed" -c 4 -o max \
  | awk 'BEGIN{OFS="\t"} {print $1, $2, $3, "D9_H3CTR_ISL1_cons_"NR, $4, $5, $4+$5}' > "${S}/D9_H3CTR_ISL1.consensus.bed"
echo "D9 two-replicate consensus: $(wc -l < "${S}/D9_H3CTR_ISL1.consensus.bed") regions"

# Regions for the size factors
for m in H3K27ac H3K27me3; do cp "${OUT_DIR}/diff/${m}/regions.saf" "${S}/${m}.saf"; done
{ cut -f1-3 "${OUT_DIR}"/isl1_ctr_final/*/D*_Ctr_ISL1.bed; cut -f1-3 "${S}/D9_H3CTR_ISL1.consensus.bed"; } \
  | sort -k1,1 -k2,2n | "${BT}" merge -i - | awk 'BEGIN{OFS="\t"; print "GeneID", "Chr", "Start", "End", "Strand"} {print "ISL1_r"NR, $1, $2 + 1, $3, "+"}' > "${S}/ISL1.saf"
for k in ISL1 H3K27ac H3K27me3; do
  mapfile -t B < <(awk -F'\t' -v k="${k}" '$2==k {print $3}' "${S}/libraries.tsv")
  "${FEATURECOUNTS}" -T 12 -p --countReadPairs -F SAF -a "${S}/${k}.saf" -o "${S}/${k}.counts.txt" "${B[@]}" 2> "${S}/${k}.featureCounts.log"
  echo "${k}: $(($(wc -l < "${S}/${k}.saf") - 1)) regions, ${#B[@]} libraries counted"
done

"$(dirname "${FEATURECOUNTS}")/Rscript" -e '
suppressPackageStartupMessages({library(DESeq2); library(data.table)})
S <- commandArgs(TRUE)[1]
lib <- fread(file.path(S, "libraries.tsv")); fr <- fread(file.path(S, "fragments.tsv"))
lib <- merge(lib, fr, by = "bam", sort = FALSE)
lib[, size_factor := NA_real_]
for (k in c("ISL1", "H3K27ac", "H3K27me3")) {
  x <- fread(file.path(S, paste0(k, ".counts.txt")), skip = "Geneid")
  m <- as.matrix(x[, 7:ncol(x)]); colnames(m) <- names(x)[7:ncol(x)]
  sf <- estimateSizeFactorsForMatrix(m)
  lib[match(names(sf), bam), size_factor := sf]
}
lib[, G := exp(mean(log(fragments))), by = kind]
lib[, scale := ifelse(kind == "IgG", 1e6 / fragments, 1e6 / (G * size_factor))]
fwrite(lib[, .(name, kind, bam, bin, groups, fragments, size_factor = round(size_factor, 4), scale = signif(scale, 6))],
       file.path(S, "scale_factors.tsv"), sep = "\t")
print(lib[, .(name, kind, fragments, size_factor = round(size_factor, 3), cpm_scale = signif(1e6 / fragments, 4), scale = signif(scale, 4))])
' "${S}"
echo "rows: $(($(wc -l < "${S}/scale_factors.tsv") - 1))"
