#!/bin/bash
#SBATCH --job-name=diffbind_env
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=04:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/build_diffbind_env.%j.out

# R env for DiffBind / csaw / edgeR (agreed 2026-11-09), its own env so isl1_downstream stays as
# built. Resolved versions: study_config/diffbind_env.export.yml.
#   sbatch scripts/00e_build_diffbind_env.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_KO_histone_cutNrun/study_config/config.sh

MM=/projects/hzhu10@xsede.org/software/micromamba_bootstrap/bin/micromamba
export MAMBA_ROOT_PREFIX=/projects/hzhu10@xsede.org/software/micromamba_bootstrap
ENVDIR=$(dirname "${DIFFBIND_TOOLS}")

"${MM}" create -y -p "${ENVDIR}" -c conda-forge -c bioconda \
  r-base=4.3 bioconductor-diffbind bioconductor-csaw bioconductor-edger bioconductor-deseq2 r-data.table
"${MM}" env export -p "${ENVDIR}" --no-build > "${STUDY_DIR}/study_config/diffbind_env.export.yml"
"${DIFFBIND_TOOLS}/Rscript" -e 'for (p in c("DiffBind","csaw","edgeR","DESeq2","data.table")) suppressPackageStartupMessages(library(p, character.only = TRUE)); cat("DiffBind", as.character(packageVersion("DiffBind")), "csaw", as.character(packageVersion("csaw")), "edgeR", as.character(packageVersion("edgeR")), "\n")'
echo "diffbind env ready: ${DIFFBIND_TOOLS}"
