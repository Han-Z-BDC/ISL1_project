#!/bin/bash
#SBATCH --job-name=filter_10x
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=240G
#SBATCH --time=12:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/filter_10x.%A_%a.out

# Step 00f (agreed 2026-11-10): remove 10x Genomics 3' GEX reads from the batch 3 CUT&RUN fastqs.
# The 10x libraries on the same lane (S268-S270, ISL1_scRNAseq/7535-0003) leaked into the CUT&RUN
# libraries with the CUT&RUN index (up to ~0.3% of pairs; they cannot be removed by index).
# A 10x 3' GEX R1 is 16 bp cell barcode + 12 bp UMI, then oligo-dT. A pair is removed when R1 has
#   >= 10 T at bases 29-38 (strict)  OR  >= 24 T in bases 29-58 (tolerates errors / a shifted start)
# On the 10x fastqs this catches 95% of R1s (the rest are cDNA without that structure and cannot
# be told from genomic fragments). On batch 1 CUT&RUN (no 10x on the lane) it removes ~0.1% of pairs.
# Both mates of a flagged pair are removed. QC per library: pairs in, removed, removed whose R1
# starts with a cell barcode seen in the 10x data (TENX_FASTQ_DIR; >= 3 reads in the first 2 M
# reads of each library), pairs out.
# Input:  ${RAW_LINKS}/<library>_R{1,2}_001.fastq.gz (raw Admera files, untouched)
# Output: ${RAW_DIR}/<library>_R{1,2}_001.fastq.gz (the pipeline's input from now on)
#         ${SCRATCH}/tenx_filter/<sample>.{tsv,removed_names.txt.gz}
#   sbatch --array=0-61%20 scripts/00f_filter_10x.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
: "${SLURM_ARRAY_TASK_ID:?ERROR: submit as an array}"
Q=${SCRATCH}/tenx_filter; CB=${Q}/cell_barcodes.txt
mkdir -p "${Q}" "${RAW_DIR}"

# Cell barcodes seen in the 10x libraries (QC column only; built once)
(
  flock 9
  set +o pipefail   # zcat | head ends with SIGPIPE
  if [[ ! -s "${CB}" ]]; then
    for f in "${TENX_FASTQ_DIR}"/*_R1_001.fastq.gz; do zcat "${f}" | head -8000000 | awk 'NR%4==2 {print substr($0, 1, 16)}'; done \
      | sort | uniq -c | awk '$1 >= 3 {print $2}' > "${CB}.tmp" && mv "${CB}.tmp" "${CB}"
  fi
) 9> "${CB}.lock"

row=$(tail -n +2 "${SAMPLE_SHEET}" | sed -n "$((SLURM_ARRAY_TASK_ID + 1))p")
[[ -n "${row}" ]] || { echo "ERROR: no sample sheet row ${SLURM_ARRAY_TASK_ID}" >&2; exit 1; }
IFS=$'\t' read -r library sample _ <<< "${row}"
r1=${RAW_LINKS}/${library}_R1_001.fastq.gz; r2=${RAW_LINKS}/${library}_R2_001.fastq.gz
o1=${RAW_DIR}/${library}_R1_001.fastq.gz; o2=${RAW_DIR}/${library}_R2_001.fastq.gz
for f in "${r1}" "${r2}"; do [[ -s "${f}" ]] || { echo "ERROR: missing ${f}" >&2; exit 1; }; done
echo "${sample}: ${library}"

paste <(zcat "${r1}" | paste - - - -) <(zcat "${r2}" | paste - - - -) \
  | awk -F'\t' -v CB="${CB}" -v s="${sample}" -v o1="${o1}.part" -v o2="${o2}.part" -v nm="${Q}/${sample}.removed_names.txt.gz.part" -v qc="${Q}/${sample}.tsv" '
    BEGIN { while ((getline l < CB) > 0) cb[l] = 1
            c1 = "pigz -p 4 > \"" o1 "\""; c2 = "pigz -p 4 > \"" o2 "\""; cn = "pigz -p 2 > \"" nm "\"" }
    {
      n++
      a = $1; sub(/ .*/, "", a); b = $5; sub(/ .*/, "", b)
      if (a != b) { print "ERROR: mates out of sync at pair " n ": " a " / " b > "/dev/stderr"; bad = 1; exit 1 }
      w = substr($2, 29, 30); k = gsub(/T/, "T", w)
      if (substr($2, 29, 10) == "TTTTTTTTTT" || k >= 24) {
        rm++; if (substr($2, 1, 16) in cb) rmb++
        print substr(a, 2) | cn
      } else {
        print $1 "\n" $2 "\n" $3 "\n" $4 | c1
        print $5 "\n" $6 "\n" $7 "\n" $8 | c2
      }
    }
    END {
      if (bad) exit 1
      close(c1); close(c2); close(cn)
      printf "sample\tpairs_in\tremoved\tremoved_with_10x_barcode\tpairs_out\tpct_removed\n%s\t%d\t%d\t%d\t%d\t%.4f\n", s, n, rm, rmb, n - rm, 100 * rm / n > qc
    }'

# Check the outputs before putting them in place
in_pairs=$(awk -F'\t' 'NR==2 {print $2}' "${Q}/${sample}.tsv"); out_pairs=$(awk -F'\t' 'NR==2 {print $5}' "${Q}/${sample}.tsv")
n1=$(($(pigz -dc -p 4 "${o1}.part" | wc -l) / 4)); n2=$(($(pigz -dc -p 4 "${o2}.part" | wc -l) / 4))
[[ "${n1}" == "${out_pairs}" && "${n2}" == "${out_pairs}" ]] || { echo "ERROR: ${sample}: out ${out_pairs}, R1 ${n1}, R2 ${n2}" >&2; exit 1; }
mv "${o1}.part" "${o1}"; mv "${o2}.part" "${o2}"; mv "${Q}/${sample}.removed_names.txt.gz.part" "${Q}/${sample}.removed_names.txt.gz"
cat "${Q}/${sample}.tsv"
