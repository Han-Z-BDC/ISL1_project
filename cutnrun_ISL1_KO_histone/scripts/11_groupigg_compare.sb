#!/bin/bash
#SBATCH --job-name=b3_grpcmp
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --time=02:00:00
#SBATCH --output=/scratch/alpine/hzhu10@xsede.org/ISL1_KO_histone_cutNrun/logs/grpcmp.%j.out

# Step 11: matched IgG vs group IgG (step 10, depth matched) for the batch 3 time course.
#   1. ISL1 option A, per control: step 03 (matched) or step 04 CONTROL=group (group) q 0.01 calls,
#      summit rows collapsed, chr1-22/X/Y only; rep1 + rep2 merged; union and both-replicate
#      consensus; chance = rep2 shuffled (same chromosome, blacklist excluded, seed 1); share of
#      the top 1000 / all consensus peaks overlapping ISL1_REFERENCE_PEAKS (QC only)
#   2. All groups, step 05 sets per control (overlap Nt / Np; IDR Nt / Np for ISL1), recounted on
#      chr1-22/X/Y; N1 / N2, ratios and flag from the step 05 qc tables; ISL1 sets also get the
#      reference share.
# Output: results/reproducibility_groupIgG/compare/{isl1_A.tsv,sets.tsv} and the option A beds
#   sbatch --dependency=afterok:<05 group job> scripts/11_groupigg_compare.sb

set -euo pipefail
IGG_METHOD=matched
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/cutnrun_ISL1_KO_histone/study_config/config.sh
BT=${TOOLS}/bedtools
O=${OUT_DIR}/reproducibility_groupIgG/compare
mkdir -p "${O}"
C=${OUT_DIR}/isl1_consensus
for f in "${C}/reference.bed" "${C}/genome.txt"; do
  [[ -s "${f}" ]] || { echo "ERROR: missing ${f} -- run step 07 first" >&2; exit 1; }
done
awk -F'\t' '$1 ~ /^chr([0-9]+|X|Y)$/' "${C}/genome.txt" > "${O}/genome.canonical.txt"
canon () { awk -F'\t' '$1 ~ /^chr([0-9]+|X|Y)$/' "$@"; }

both () {
  # $1 $2 = region beds -> merged regions holding a region from both (count)
  { awk 'BEGIN{OFS="\t"} {print $1, $2, $3, 1}' "$1"; awk 'BEGIN{OFS="\t"} {print $1, $2, $3, 2}' "$2"; } \
    | sort -k1,1 -k2,2n | "${BT}" merge -i - -c 4 -o count_distinct | awk '$4 == 2' | wc -l
}
ref () {
  # $1 = bed, $2 = score column -> "top1000_pct<TAB>all_pct"
  local n top all
  n=$(wc -l < "$1" | tr -d ' ')
  (( n > 0 )) || { echo -e "NA\tNA"; return; }
  top=$(sort -k"$2","$2"gr "$1" | head -1000 | cut -f1-3 | sort -k1,1 -k2,2n | "${BT}" intersect -u -a - -b "${C}/reference.bed" | wc -l)
  all=$(cut -f1-3 "$1" | sort -k1,1 -k2,2n | "${BT}" intersect -u -a - -b "${C}/reference.bed" | wc -l)
  awk -v n="${n}" -v t="${top}" -v a="${all}" 'BEGIN{k=(n<1000?n:1000); printf "%.1f\t%.1f", 100*t/k, 100*a/n}'
}

# 1. ISL1 option A
mapfile -t GRPS < <(awk -F'\t' -v L=" ${REPRO_LINES} " 'NR>1 && index(L, " "$4" ") && $6=="ISL1" {print $3"_"$4"_"$6}' "${METADATA}" | sort -u)
a_out=${O}/isl1_A.tsv
echo -e "group\tcontrol\trep1_peaks\trep2_peaks\tunion\tboth\tchance\tboth_over_chance\tMb\ttop1000_in_reference_pct\tall_in_reference_pct" > "${a_out}"
for group in "${GRPS[@]}"; do
  mapfile -t REPS < <(awk -F'\t' -v g="${group}" 'NR>1 && $3"_"$4"_"$6==g {print $5"\t"$1}' "${METADATA}" | sort -n | cut -f2)
  r1=${REPS[0]}; r2=${REPS[1]}
  for ctl in matched group; do
    [[ ${ctl} == matched ]] && M=${OUT_DIR}/macs3 || M=${OUT_DIR}/macs3_groupIgG
    D=${O}/A_${ctl}; mkdir -p "${D}"
    for s in "${r1}" "${r2}"; do
      canon "${M}/${s}_peaks.filtered.narrowPeak" | awk 'BEGIN{OFS="\t"} {print $1, $2, $3, $8}' \
        | sort -k1,1 -k2,2n | "${BT}" merge -i - -c 4 -o max > "${D}/${s}.regions.bed"
    done
    a=${D}/${r1}.regions.bed; b=${D}/${r2}.regions.bed
    { awk 'BEGIN{OFS="\t"} {print $1, $2, $3, 1}' "${a}"; awk 'BEGIN{OFS="\t"} {print $1, $2, $3, 2}' "${b}"; } \
      | sort -k1,1 -k2,2n | "${BT}" merge -i - -c 4 -o count_distinct > "${D}/${group}.union.bed"
    awk 'BEGIN{OFS="\t"} $4 == 2 {print $1, $2, $3}' "${D}/${group}.union.bed" \
      | "${BT}" map -g "${O}/genome.canonical.txt" -a - -b "${a}" -c 4 -o max \
      | "${BT}" map -g "${O}/genome.canonical.txt" -a - -b "${b}" -c 4 -o max \
      | awk -v g="${group}" 'BEGIN{OFS="\t"} {print $1, $2, $3, g"_cons_"NR, $4, $5, $4+$5}' > "${D}/${group}.consensus.bed"
    cut -f1-3 "${b}" | "${BT}" shuffle -i - -g "${O}/genome.canonical.txt" -chrom -excl "${BLACKLIST}" \
      -noOverlapping -seed 1 | sort -k1,1 -k2,2n > "${D}/tmp.shuffled.bed"
    ch=$(both "${a}" "${D}/tmp.shuffled.bed"); rm -f "${D}/tmp.shuffled.bed"
    nb=$(wc -l < "${D}/${group}.consensus.bed" | tr -d ' ')
    echo -e "${group}\t${ctl}\t$(wc -l < "${a}" | tr -d ' ')\t$(wc -l < "${b}" | tr -d ' ')\t$(wc -l < "${D}/${group}.union.bed" | tr -d ' ')\t${nb}\t${ch}\t$(awk -v o="${nb}" -v c="${ch}" 'BEGIN{print (c > 0 ? sprintf("%.1f", o/c) : "NA")}')\t$(awk '{t+=$3-$2} END{printf "%.1f", t/1e6}' "${D}/${group}.consensus.bed")\t$(ref "${D}/${group}.consensus.bed" 7)" >> "${a_out}"
  done
done
column -t "${a_out}"

# 2. Step 05 sets, matched vs group
s_out=${O}/sets.tsv
echo -e "group\tantibody\tmethod\tcontrol\tN1\tN2\tNt\tNp\tself_consistency\trescue\tencode_flag\tNt_Mb\tNp_Mb\tNt_top1000_ref_pct\tNp_top1000_ref_pct" > "${s_out}"
mapfile -t ALL < <(awk -F'\t' -v L=" ${REPRO_LINES} " -v A=" ${REPRO_ANTIBODIES} " 'NR>1 && index(L, " "$4" ") && index(A, " "$6" ") {print $3"_"$4"_"$6}' "${METADATA}" | sort -u)
for group in "${ALL[@]}"; do
  for ctl in matched group; do
    [[ ${ctl} == matched ]] && R=${OUT_DIR}/reproducibility || R=${OUT_DIR}/reproducibility_groupIgG
    qc=${R}/qc/${group}.repro_qc.tsv
    [[ -s "${qc}" ]] || { echo "ERROR: missing ${qc}" >&2; exit 1; }
    # qc columns: group antibody method rep1 rep2 rep1_relaxed rep2_relaxed pooled_relaxed N1 N2 Nt Np self rescue flag ...
    tail -n +2 "${qc}" | while IFS=$'\t' read -r g ab m x1 x2 x3 x4 x5 n1 n2 nt np selfc rescue flag rest; do
      t=${R}/${m}/${group}.Nt.narrowPeak; p=${R}/${m}/${group}.Np.narrowPeak
      canon "${t}" > "${O}/tmp.t.bed"; canon "${p}" > "${O}/tmp.p.bed"
      if [[ "${ab}" == ISL1 ]]; then rt=$(ref "${O}/tmp.t.bed" 8 | cut -f1); rp=$(ref "${O}/tmp.p.bed" 8 | cut -f1); else rt=NA; rp=NA; fi
      echo -e "${group}\t${ab}\t${m}\t${ctl}\t${n1}\t${n2}\t$(wc -l < "${O}/tmp.t.bed" | tr -d ' ')\t$(wc -l < "${O}/tmp.p.bed" | tr -d ' ')\t${selfc}\t${rescue}\t${flag}\t$(awk '{t+=$3-$2} END{printf "%.1f", t/1e6}' "${O}/tmp.t.bed")\t$(awk '{t+=$3-$2} END{printf "%.1f", t/1e6}' "${O}/tmp.p.bed")\t${rt}\t${rp}" >> "${s_out}"
    done
  done
done
rm -f "${O}/tmp.t.bed" "${O}/tmp.p.bed"
column -t "${s_out}"
