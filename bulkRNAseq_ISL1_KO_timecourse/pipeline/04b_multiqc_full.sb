#!/bin/bash
#SBATCH --job-name=isl1_tc_multiqc_full
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=00:20:00
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/logs/multiqc_full.%j.out
#SBATCH --error=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/logs/multiqc_full.%j.err

# Full-pipeline MultiQC aggregate, run once after the 04_qc_bam.sb array
# finishes for all samples (kept separate from that array so this doesn't
# run 12 times / race on the same output file).

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/config.sh
# Copied from the C7S59W bulk run (bulkRNAseq/scripts, ISL1_project commit 290c3e1); comments about earlier
# results refer to that run.

echo "[$(date)] MultiQC (full pipeline: raw fastqc + fastp + STAR + UMI dedup + featureCounts + bam QC)"
"${TOOLS}/multiqc" "${OUT_DIR}/qc" "${OUT_DIR}/results/star" "${OUT_DIR}/results/counts" -o "${OUT_DIR}/qc" --force -n multiqc_full_report

echo "[$(date)] Done. Report: ${OUT_DIR}/qc/multiqc_full_report.html"
