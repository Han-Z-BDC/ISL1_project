#!/bin/bash
#SBATCH --job-name=isl1_tc_bamqc
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --array=0-11
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/logs/bamqc.%A_%a.out
#SBATCH --error=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/logs/bamqc.%A_%a.err

# Post-alignment BAM QC, one array task per sample (about a minute each).
# flagstat/idxstats on the STAR BAM (mapping before dedup); rseqc infer_experiment
# on the UMI-deduplicated BAM, which must confirm forward strandedness
# (featureCounts -s 1 in 03b_featurecounts.sb) before the counts are used.
#
# No rseqc geneBody_coverage: these are 3'-end libraries, so reads pile up at the
# 3' end by design and the plot cannot show degradation; over all genes it also ran
# past 1.5 h per sample.
#
# Assumes the BED12 gene model already exists at ${GENOME_DIR}/genes/genes.bed12.

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/config.sh

s="${SAMPLES[${SLURM_ARRAY_TASK_ID}]}"
BAM="${OUT_DIR}/results/star/${s}/Aligned.sortedByCoord.out.bam"
DEDUP_BAM="${OUT_DIR}/results/dedup/${s}.dedup.bam"
BAMQC_DIR="${OUT_DIR}/qc/bam"
BED12="${GENOME_DIR}/genes/genes.bed12"
mkdir -p "${BAMQC_DIR}" "${LOGS}"

echo "[$(date)] samtools QC: ${s}"
"${TOOLS}/samtools" flagstat "${BAM}" > "${BAMQC_DIR}/${s}.flagstat.txt"
"${TOOLS}/samtools" idxstats "${BAM}" > "${BAMQC_DIR}/${s}.idxstats.txt"

echo "[$(date)] rseqc infer_experiment: ${s}"
"${TOOLS}/infer_experiment.py" -i "${DEDUP_BAM}" -r "${BED12}" \
  > "${BAMQC_DIR}/${s}.infer_experiment.txt" 2>&1

echo "[$(date)] Done: ${s}"
