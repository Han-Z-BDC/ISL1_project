#!/bin/bash
#SBATCH --job-name=isl1_tc_limma
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --time=00:30:00
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/logs/limma.%j.out
#SBATCH --error=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/logs/limma.%j.err

# limma-voom cross-check (07_limma_voom_timecourse.R) on the featureCounts table.
# Needs results/counts/gene_annotation.tsv (written by 06_deseq2_timecourse.sb).

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/bulkRNAseq_ISL1_KO_timecourse/config.sh

echo "[$(date)] limma"
"${R_ENV}/bin/Rscript" "${OUT_DIR}/pipeline/07_limma_voom_timecourse.R" "${OUT_DIR}"
echo "[$(date)] Done"
