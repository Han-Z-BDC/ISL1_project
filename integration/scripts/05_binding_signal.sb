#!/bin/bash
#SBATCH --job-name=int05_signal
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 05: ISL1 binding signal per day at the sites of each KO-effect cluster. Needs step 03.
# Submit from integration/:  sbatch scripts/05_binding_signal.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/05_binding_signal.R" "${CNR_DIFF}" "${RESULTS}" "${RESULTS}/05_binding_signal"
