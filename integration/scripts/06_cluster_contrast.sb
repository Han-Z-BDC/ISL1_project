#!/bin/bash
#SBATCH --job-name=int06_contrast
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 06: ISL1 binding at alpha-leaning vs beta-leaning sites, per day and over time, libraries as replicates.
# Needs steps 03 and 05. Submit from integration/:  sbatch scripts/06_cluster_contrast.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/06_cluster_contrast.R" "${CNR_DIFF}" "${RESULTS}" "${MARKERS}" \
  "${RESULTS}/06_cluster_contrast"
