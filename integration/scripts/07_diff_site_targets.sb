#!/bin/bash
#SBATCH --job-name=int07_targets
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 07: target genes of the differentially bound ISL1 sites and their KO effect. Needs steps 01-03.
# Submit from integration/:  sbatch scripts/07_diff_site_targets.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/07_diff_site_targets.R" "${RESULTS}" "${RESULTS}/07_diff_site_targets"
