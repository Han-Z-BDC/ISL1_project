#!/bin/bash
#SBATCH --job-name=int11_actstage
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 11: direct-activated genes with a stage-specific KO effect, k-means on the timing of the effect. Needs step 02.
# Submit from integration/:  sbatch scripts/11_activated_stage.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/11_activated_stage.R" "${RESULTS}" "${RESULTS}/11_activated_stage"
