#!/bin/bash
#SBATCH --job-name=int09_overlap
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 09: target genes of the CUT&RUN step 12 overlap classes against the KO-effect groups. Needs steps 01, 02, 08 and CUT&RUN step 12.
# Submit from integration/:  sbatch scripts/09_peak_overlap.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/09_peak_overlap.R" "${CNR_OVERLAP}" "${RESULTS}" "${MARKERS}" "${RESULTS}/09_peak_overlap"
