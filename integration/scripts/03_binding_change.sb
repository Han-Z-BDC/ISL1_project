#!/bin/bash
#SBATCH --job-name=int03_binding
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 03: ISL1 binding change near each bulk KO-effect group (voom + camera). Needs steps 01-02.
# Submit from integration/:  sbatch scripts/03_binding_change.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/03_binding_change.R" "${CNR_DIFF}" "${RESULTS}" "${RESULTS}/03_binding_change"
