#!/bin/bash
#SBATCH --job-name=int11_stage
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=00:30:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=7G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 11: direct-activated and direct-repressed genes with a stage-specific KO effect, k-means on the timing of the
# effect. Needs step 02.
# Submit from integration/:  sbatch scripts/11_direct_stage.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
for lab in activated repressed; do
  "${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/11_direct_stage.R" "${RESULTS}" "${lab}" "${RESULTS}/11_${lab}_stage"
done
