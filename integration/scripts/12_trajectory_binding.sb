#!/bin/bash
#SBATCH --job-name=int12_traj_binding
#SBATCH --account=amc-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --time=01:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=15G
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/logs/%x.%j.out
# Step 12: ISL1 binding (CUT&RUN step 13 TSS / ABC links, per stage and any stage) and TSS signal of the D15 scRNA-seq
# trajectory gene clusters (scRNAseq 7.3h k = 10). Needs CUT&RUN steps 08 and 13 and scRNAseq 7.3h / 7.3l.
# Submit from integration/:  sbatch scripts/12_trajectory_binding.sb

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_project/integration/config.sh
O=${RESULTS}/12_trajectory_binding
ABC_DIR=/pl/active/ZhuLab_BDC/Han_analysis/diff_multiome_2026/out/abc/results   # as CUT&RUN step 13
ABC_GROUPS=ENP2,ENP3,early_SC_alpha
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/12_trajectory_binding.R" prep "${SC_TRAJ}/gene_patterns/gene_patterns_k10.csv" \
  "${SC_TRAJ}/pb_curve.csv" "${CNR_ABC}/links.tsv" "${GTF}" "${O}"
# bigWigs (~0.9 GB each) copied to node-local disk first: read from /scratch, the parallel computeMatrix workers
# stalled on I/O (2026-11-24, 0% CPU after 40 min); one process on the local copies
L=${SLURM_SCRATCH:-${TMPDIR:-/tmp}}/int12_bw; mkdir -p "${L}"
for d in D15 D18 D22; do cp "${CNR_TRACKS}/${d}_Ctr_ISL1.mean.bw" "${L}/"; done
"${CNR_TOOLS}/computeMatrix" reference-point --referencePoint TSS -b 3000 -a 3000 --binSize 50 \
  -R "${O}/tss.bed" -S "${L}"/D15_Ctr_ISL1.mean.bw "${L}"/D18_Ctr_ISL1.mean.bw "${L}"/D22_Ctr_ISL1.mean.bw \
  --samplesLabel D15 D18 D22 --missingDataAsZero --sortRegions keep -p 1 -o "${O}/tss_matrix.gz"
rm -r "${L}"
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/12_trajectory_binding.R" plot "${O}"
# binding mode per stage (TSS only / TSS + enhancer / enhancer only / all), Fisher and adjusted logistic regression
"${R_ENV}/bin/Rscript" "${INT_DIR}/scripts/12_trajectory_binding.R" mode "${O}" "${CNR_ABC}/links.tsv" \
  "${SC_TRAJ}/pb_curve.csv" "${ABC_DIR}" "${ABC_GROUPS}"
