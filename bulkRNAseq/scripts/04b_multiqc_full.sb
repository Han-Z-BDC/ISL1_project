#!/bin/bash
#SBATCH --job-name=isl1_rnaseq_multiqc_full
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=00:20:00
#SBATCH --output=/pl/active/ZhuLab_BDC/GitHub/ISL1_bulkRNAseq/logs/multiqc_full.%j.out
#SBATCH --error=/pl/active/ZhuLab_BDC/GitHub/ISL1_bulkRNAseq/logs/multiqc_full.%j.err

# Full-pipeline MultiQC aggregate, run once after the 04_qc_bam.sb array
# finishes for all samples (kept separate from that array so this doesn't
# run 12 times / race on the same output file).

set -euo pipefail
source /pl/active/ZhuLab_BDC/GitHub/ISL1_bulkRNAseq/config.sh

echo "[$(date)] MultiQC (full pipeline: raw fastqc + fastp + STAR + bam QC)"
"${TOOLS}/multiqc" "${OUT_DIR}/qc" -o "${OUT_DIR}/qc" --force -n multiqc_full_report

echo "[$(date)] Done. Report: ${OUT_DIR}/qc/multiqc_full_report.html"
